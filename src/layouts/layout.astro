                        <img src="/icons/icons8-home-50.png" alt="Home Icon" class="w-5 h-5 object-contain [filter:brightness(0)_saturate(100%)_invert(21%)_sepia(47%)_saturate(2541%)_hue-rotate(203deg)_brightness(94%)_contrast(98%)] transition-transform duration-300 group-hover:scale-110" />
