    <!-- BACK TO TOP BUTTON -->
    <button 
        id="backToTopBtn" 
        aria-label="Quay lại đầu trang"
        class="fixed bottom-6 right-6 z-[1999] bg-white/80 backdrop-blur-sm hover:bg-[#ED2424] text-white w-12 h-12 rounded-full shadow-2xl flex items-center justify-center transition-all duration-300 opacity-0 invisible translate-y-4 hover:scale-110 border-2 border-[#214080] cursor-pointer group"
    >
        <img 
            src="/icons/icons8-up-arrow-48.png" 
            alt="Up Arrow" 
            class="w-5 h-5 object-contain [filter:brightness(0)_saturate(100%)_invert(21%)_sepia(47%)_saturate(2541%)_hue-rotate(203deg)_brightness(94%)_contrast(98%)] transition-all duration-300 group-hover:-translate-y-1 group-hover:brightness-0 group-hover:invert-100" 
        />
    </button>

    <!-- GENERAL MODAL CONTAINER -->
    <div class="fixed inset-0 bg-[#214080]/85 backdrop-blur-[2px] z-[2000] flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 p-4" id="globalModal">
        <div class="bg-white w-full max-w-[750px] max-h-[90vh] overflow-y-auto relative p-6 sm:p-10 border border-[#E6EAF2]">
