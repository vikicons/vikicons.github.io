            <!-- Nút Báo Giá Dự Án & Nút Menu Hamburger Mobile -->
            <div class="flex items-center gap-3">
                <a href="/bao-gia" data-key="nav_quote_btn" class="hidden sm:inline-flex bg-red-600 hover:bg-[#264ABC] text-white px-4 py-2.5 text-sm sm:text-base font-bold uppercase tracking-wider items-center gap-2 transition shadow-md no-underline">
