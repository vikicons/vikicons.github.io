            <a href="/news" data-key="nav_news" class="block font-semibold py-2 text-base text-[#214080] uppercase border-b border-[#E6EAF2] no-underline">Tin tức</a>
            <a href="/careers-vn" data-key="nav_careers" class="block font-semibold py-2 text-base text-[#214080] uppercase border-b border-[#E6EAF2] no-underline">Tuyển dụng</a>
            <a href="/contact" data-key="nav_contact" class="block font-semibold py-2 text-base text-[#214080] uppercase border-b border-[#E6EAF2] no-underline">Liên hệ</a>
            <a href="/bao-gia" data-key="nav_quote" class="block text-center bg-red-600 text-white py-3 font-bold uppercase text-base mt-2 no-underline">Báo Giá</a>
        </div>
    </header>

    <!-- MAIN CONTENT SLOT -->
    <main class="flex-grow">
        <slot />
    </main>

