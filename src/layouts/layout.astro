                <!-- Cột 2: Lĩnh vực hoạt động -->
                <div>
                    <h4 class="text-[#FAF9F9] text-base font-bold uppercase tracking-wider mb-5 pb-2 border-b border-white/15" data-key="footer_col2_title">
                        Lĩnh Vực Hoạt Động
                    </h4>
                    <ul class="list-none space-y-2.5 m-0 p-0 text-sm">
                        <li><a href="/services#civil" class="text-[#FAF9F9]/70 hover:text-[#ED2424] hover:underline transition-colors duration-200 no-underline block" data-key="footer_s1">Xây dựng Dân dụng & Công nghiệp</a></li>
