                    <a href="/privacy" class="text-[#FAF9F9]/70 hover:text-[#ED2424] hover:underline transition-colors duration-200 no-underline" data-key="footer_privacy">Điều khoản bảo mật</a>
                    <a href="/terms" class="text-[#FAF9F9]/70 hover:text-[#ED2424] hover:underline transition-colors duration-200 no-underline" data-key="footer_terms">Chính sách chất lượng</a>
