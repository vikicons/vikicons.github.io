---
import '../styles/global.css';

// Import trực tiếp từ điển JSON từ thư mục src/data/lang/ vào đây
import viLang from '../data/lang/vi.json';
import enLang from '../data/lang/en.json';

interface Props {
    title?: string;
}
const { title = "VIKI - Công Ty Cổ Phần Xây Dựng  | Xây Giá Trị - Dựng Niềm Tin" } = Astro.props;

// Gom chung vào một object từ điển trên server
const translationsData = {
    vi: viLang,
    en: enLang
};
---
 
<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <!-- Google Fonts: Lexend Deca -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<!-- ĐÃ FIX: Thêm min-h-screen flex flex-col để quản lý chiều cao toàn trang -->
<body class="bg-white text-[#214080] antialiased overflow-x-hidden font-sans min-h-screen flex flex-col relative">

    <!-- TOP UTILITY BAR & MOBILE HEADER CONTAINER -->
    <header class="sticky top-0 z-[90] bg-white border-b border-[#E6EAF2]">
        
        <!-- THANH CÔNG CỤ TRÊN CÙNG: Dùng chung cho cả Mobile và Desktop -->
        <div class="bg-[#214080] text-white text-[0.8125rem] py-2 border-b border-white/10 relative z-[100]">
            <div class="container mx-auto px-2 flex justify-between items-center gap-2">
                
                <!-- BÊN TRÁI (Desktop thấy, mobile ẩn hoặc thu gọn nếu cần): Hotline & Email -->
                <div class="hidden lg:flex items-center gap-4">
                    <a href="tel:0814667501" class="flex items-center gap-1.5 no-underline" title="Gọi ngay">
                        <span class="shrink-0 inline-flex items-center">
                            <img src="/icons/icons8-office-phone-94.png" alt="Phone Icon" class="w-3.5 h-3.5 object-contain">
                        </span>
                        <span class="text-white hover:text-[#ED2424] transition-colors duration-200">0814667501</span>
                    </a>
                    <span class="text-white/20">|</span>
                    <a href="mailto:viki.construction.co@gmail.com" class="flex items-center gap-1.5 no-underline" title="Gửi email">
                        <span class="shrink-0 inline-flex items-center">
                            <img src="/icons/icons8-gmail-logo-94.png" alt="Email Icon" class="w-3.5 h-3.5 object-contain">
                        </span>
                        <span class="text-white hover:text-[#ED2424] transition-colors duration-200">viki.construction.co@gmail.com</span>
                    </a>
                </div>

                <!-- BÊN PHẢI (Cả Mobile và Desktop đều hiển thị chung 1 hàng): Menu ngôn ngữ & Ô tìm kiếm -->
                <div class="flex items-center gap-2 sm:gap-4 ml-auto">
                    <!-- Dropdown Ngôn ngữ -->
                    <div class="relative">
                        <button id="langDropdownBtn" class="flex items-center justify-between gap-2 bg-transparent border border-white/30 text-white px-2.5 py-1 text-xs font-semibold cursor-pointer hover:border-[#5FD1C1] transition w-28 sm:w-36">
                            <span class="flex items-center gap-1.5 truncate">
                                <span class="shrink-0 inline-flex items-center">
                                    <img src="/icons/icons8-language-94.png" alt="Lang Icon" class="w-3.5 h-3.5 object-contain">
                                </span>
                                <span id="currentLangText" class="font-bold truncate" data-key="current_lang">Việt Nam</span>
                            </span>
                            <span>▼</span>
                        </button>
                        
                        <!-- Menu chọn ngôn ngữ với hiệu ứng hover mượt mà -->
                        <div id="langMenu" class="hidden absolute top-full right-0 sm:left-0 mt-1 w-36 bg-[#214080] border border-white/25 shadow-2xl z-[9999]">
                            <button class="w-full text-left px-3 py-2 text-xs text-white font-bold hover:bg-[#5FD1C1] hover:text-[#214080] transition lang-option cursor-pointer border-none bg-transparent" data-lang="vi">
                                🇻🇳 Việt Nam
                            </button>
                            <button class="w-full text-left px-3 py-2 text-xs text-slate-300 font-normal hover:bg-[#5FD1C1] hover:text-[#214080] transition lang-option cursor-pointer border-none bg-transparent" data-lang="en">
                                🇬🇧 English
                            </button>
                        </div>
                    </div>

                    <!-- Ô tìm kiếm nhỏ gọn trên thanh top bar -->
                    <div class="relative flex items-center">
                        <input 
                            type="text" 
                            id="globalSearchInput" 
                            placeholder="Tìm kiếm..." 
                            data-key="search_placeholder"
                            class="bg-transparent border border-white/30 text-white placeholder-slate-300 text-xs px-2.5 py-1 pr-7 outline-none focus:border-[#5FD1C1] w-28 sm:w-44 transition"
                        />
                        <span class="absolute right-2 text-slate-300 text-xs pointer-events-none">🔍</span>
                    </div>
                </div>

            </div>
        </div>

        <!-- MAIN HEADER NAVIGATION (Logo & Menu chính) -->
        <div class="container mx-auto px-2 flex justify-between items-center h-16 sm:h-20">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-3 no-underline group">
