                        <!-- KHÁCH HÀNG 6 -->
                        <div class="w-full shrink-0 px-2 sm:px-4">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                                <div class="lg:col-span-3 flex justify-center">
                                    <div class="relative rounded-lg overflow-hidden shadow-md w-full max-w-[260px] aspect-square bg-slate-200">
                                        <img src="/khachHang6.png" alt="Trưởng phòng Quản lý Chất lượng Dự án" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/img/slide001.webp';">
                                        <div class="absolute bottom-2 left-2 w-5 h-5 border-l-2 border-b-2 border-[#5FD1C1]"></div>
                                    </div>
