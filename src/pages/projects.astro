<!-- SCRIPT: LỌC, PHÂN TRANG, CUỘN VỀ ĐẦU LƯỚI VÀ ĐA NGÔN NGỮ CHO CARD -->
<script define:vars={{ projectsData: projects, i18nDict, SECTOR_KEYS, REGION_KEYS }}>
    const ITEMS_PER_PAGE = 6;
    const ACTIVE_CLASSES = ['font-bold', 'text-[#214080]', 'border-l-[3px]', 'border-solid', 'border-[#214080]', 'pl-3'];
    const INACTIVE_CLASSES = ['text-[#5A6E85]'];

    // Chữ tiếng Việt dự phòng khi không tìm thấy từ điển
    const FALLBACK_TEXT = {
        industrial: 'Khu công nghiệp', livestock: 'Hạ tầng chăn nuôi',
        north: 'Miền Bắc', central: 'Miền Trung', south: 'Miền Nam'
    };

    let currentFilter = 'all';
    let currentPage = 1;
    let currentLang = 'vi';

    const gridEl = document.getElementById('project-grid');
    const paginationEl = document.getElementById('pagination-container');
    const rightColumnEl = document.getElementById('right-content-column');
    const filterButtons = document.querySelectorAll('.filter-btn');
    const titleEl = document.getElementById('projects-page-title');

    if (!Object.keys(i18nDict).length) {
        console.warn('[projects] Không tìm thấy vi.json / en.json trong /src. Card sẽ hiển thị tiếng Việt.');
    }

    // ---------- Đa ngôn ngữ ----------
    // Ngôn ngữ hiện tại = so khớp chữ trên tiêu đề trang (do layout dịch) với từ điển.
    // Cách này không phụ thuộc vào cơ chế đổi ngôn ngữ của layout.
    function detectLang() {
        const text = (titleEl ? titleEl.textContent : '').trim();
        for (const [code, dict] of Object.entries(i18nDict)) {
            if (dict.projects_page_title && dict.projects_page_title === text) return code;
        }
        return 'vi';
    }

    function t(key, fallback) {
        const d = i18nDict[currentLang] || {};
        const vi = i18nDict.vi || {};
        return d[key] ?? vi[key] ?? fallback;
    }

    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    // ---------- Lọc ----------
    function getFiltered() {
        if (currentFilter === 'all') return projectsData;
        if (currentFilter === 'featured') return projectsData.slice(0, 3);
        return projectsData.filter(p => p.category === currentFilter || p.region === currentFilter);
    }

    // ---------- Cuộn về đầu lưới (tính theo vị trí thực, không dùng số cứng) ----------
    function getHeaderOffset() {
        const cssVar = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h'));
        if (!Number.isNaN(cssVar)) return cssVar;
        const header = document.querySelector('header');
        return header ? header.offsetHeight : 96;
    }

    function scrollToGridTop(smooth) {
        const GAP = 16;
        const top = rightColumnEl.getBoundingClientRect().top + window.scrollY - getHeaderOffset() - GAP;
        window.scrollTo({ top: Math.max(0, top), behavior: smooth ? 'smooth' : 'auto' });
    }

    // ---------- Render ----------
    function renderProjects() {
        const filtered = getFiltered();
        const totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE));
        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * ITEMS_PER_PAGE;
        const items = filtered.slice(start, start + ITEMS_PER_PAGE);

        gridEl.innerHTML = items.map(item => {
            const title = escapeHtml(t(item.titleKey, item.title));
            const sectorKey = SECTOR_KEYS[item.category];
            const regionKey = REGION_KEYS[item.region];
            const sectorText = escapeHtml(t(sectorKey, FALLBACK_TEXT[item.category]));
            const regionText = escapeHtml(t(regionKey, FALLBACK_TEXT[item.region]));
            return `
            <div class="bg-white rounded-xl overflow-hidden border border-[#E6EAF2] shadow-sm hover:shadow-md transition flex flex-col group">
                <div class="h-60 overflow-hidden bg-slate-100 relative">
                    <img src="${item.image}" alt="${title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" onerror="this.onerror=null; this.src='/img/slide001.webp';">
                </div>
                <div class="p-6 flex-1 flex flex-col justify-between">
                    <h3 data-key="${item.titleKey}" class="text-base font-bold uppercase text-[#16315E] mb-3 line-clamp-2 overflow-hidden text-ellipsis" title="${title}">
                        ${title}
                    </h3>
                    <div class="flex flex-wrap gap-2 pt-3 border-t border-gray-100">
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-[#FAF9F9] border border-[#E6EAF2] text-[11px] font-semibold text-[#214080]">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                            <span data-key="${sectorKey}">${sectorText}</span>
                        </span>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-[#FAF9F9] border border-[#E6EAF2] text-[11px] font-semibold text-[#214080]">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                            <span data-key="${regionKey}">${regionText}</span>
                        </span>
                    </div>
                </div>
            </div>`;
        }).join('');

        let html = '';
        if (totalPages > 1) {
            const prevDisabled = currentPage === 1 ? 'opacity-40 pointer-events-none' : '';
            const nextDisabled = currentPage === totalPages ? 'opacity-40 pointer-events-none' : '';
            html += `<button type="button" data-page="${currentPage - 1}" aria-label="Previous page" class="page-btn w-10 h-10 flex items-center justify-center border border-gray-300 bg-white text-gray-500 hover:bg-gray-100 transition rounded ${prevDisabled}">&larr;</button>`;
            for (let i = 1; i <= totalPages; i++) {
                if (i === currentPage) {
                    html += `<button type="button" class="w-10 h-10 flex items-center justify-center bg-[#214080] text-white font-bold rounded">${i}</button>`;
                } else {
                    html += `<button type="button" data-page="${i}" class="page-btn w-10 h-10 flex items-center justify-center border border-gray-300 bg-white text-[#214080] hover:bg-gray-100 transition rounded font-semibold">${i}</button>`;
                }
            }
            html += `<button type="button" data-page="${currentPage + 1}" aria-label="Next page" class="page-btn w-10 h-10 flex items-center justify-center border border-gray-300 bg-white text-gray-500 hover:bg-gray-100 transition rounded ${nextDisabled}">&rarr;</button>`;
        }
        paginationEl.innerHTML = html;
    }

    // ---------- Phân trang (event delegation) ----------
    paginationEl.addEventListener('click', (e) => {
        const btn = e.target.closest('.page-btn');
        if (!btn) return;
        const page = parseInt(btn.dataset.page, 10);
        const totalPages = Math.max(1, Math.ceil(getFiltered().length / ITEMS_PER_PAGE));
        if (page < 1 || page > totalPages) return;

        currentPage = page;
        renderProjects();
        requestAnimationFrame(() => scrollToGridTop(true));
    });

    // ---------- Bộ lọc ----------
    filterButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const target = e.currentTarget;

            filterButtons.forEach(b => {
                b.classList.remove(...ACTIVE_CLASSES);
                b.classList.add(...INACTIVE_CLASSES);
            });
            target.classList.remove(...INACTIVE_CLASSES);
            target.classList.add(...ACTIVE_CLASSES);

            currentFilter = target.dataset.filter;
            currentPage = 1;
            renderProjects();

            // Luôn đưa đầu lưới về đúng một vị trí cố định, bất kể số lượng dự án
            requestAnimationFrame(() => scrollToGridTop(false));
        });
    });

    // ---------- Theo dõi đổi ngôn ngữ: layout dịch tiêu đề -> dựng lại card ----------
    if (titleEl) {
        new MutationObserver(() => {
            const lang = detectLang();
            if (lang !== currentLang) {
                currentLang = lang;
                renderProjects();
            }
        }).observe(titleEl, { childList: true, characterData: true, subtree: true });
    }

    currentLang = detectLang();
    renderProjects();

    // ---------- Bộ lọc (Xử lý riêng biệt cho Desktop và Mobile không bị mất chữ) ----------
    filterButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const clickedBtn = e.currentTarget;
            const targetFilter = clickedBtn.getAttribute('data-filter');
            const isDesktop = Boolean(clickedBtn.closest('#sticky-sidebar'));

            // Duyệt qua tất cả các nút lọc để cập nhật trạng thái
            filterButtons.forEach(b => {
                const inDesktopSidebar = Boolean(b.closest('#sticky-sidebar'));
                const isMatch = (b.getAttribute('data-filter') === targetFilter);

                if (inDesktopSidebar) {
                    // --- XỬ LÝ CHO GIAO DIỆN DESKTOP (Sidebar dọc) ---
                    if (isMatch) {
                        // Mục được chọn: Chữ xanh đậm, đậm nét, có viền trái nhận diện
                        b.classList.remove('text-[#5A6E85]', 'font-normal');
                        b.classList.add('text-[#214080]', 'font-bold', 'border-l-[3px]', 'border-solid', 'border-[#214080]', 'pl-3');
                    } else {
                        // Mục không chọn: Chữ xám nhạt, bỏ viền trái
                        b.classList.remove('text-[#214080]', 'font-bold', 'border-l-[3px]', 'border-solid', 'border-[#214080]', 'pl-3');
                        b.classList.add('text-[#5A6E85]', 'font-normal');
                    }
                } else {
                    // --- XỬ LÝ CHO GIAO DIỆN MOBILE / IPAD (Nút pill ngang) ---
                    if (isMatch) {
                        // Mục được chọn: Nền xanh, chữ trắng
                        b.classList.remove('bg-[#FAF9F9]', 'bg-white', 'text-[#5A6E85]', 'border-[#E6EAF2]');
                        b.classList.add('bg-[#214080]', 'text-white', 'font-bold', 'border-[#214080]');
                    } else {
                        // Mục không chọn: Nền trắng/xám nhẹ, chữ xanh nhạt
                        b.classList.remove('bg-[#214080]', 'text-white', 'font-bold');
                        b.classList.add('bg-[#FAF9F9]', 'text-[#5A6E85]', 'border', 'border-[#E6EAF2]');
                    }
                }
            });

            currentFilter = targetFilter;
            currentPage = 1;
            renderProjects();

            // Cuộn về đầu lưới mượt mà
            requestAnimationFrame(() => scrollToGridTop(false));
        });
    });

    // ---------- Slider Khách hàng tự động chạy (Phải -> Trái) ----------
    const testimonialWrapper = document.getElementById('testimonial-slider-wrapper');
    const testimonialTrack = document.getElementById('testimonial-track');
    const prevTestimonialBtn = document.getElementById('testimonial-prev');
    const nextTestimonialBtn = document.getElementById('testimonial-next');
    const dotsContainer = document.getElementById('testimonial-dots');

    if (testimonialTrack && testimonialTrack.children.length > 0) {
        const totalSlides = testimonialTrack.children.length;
        let slideIndex = 0;
        let autoSlideTimer = null;

        // Tạo các chấm chỉ báo (dots)
        if (dotsContainer) {
            dotsContainer.innerHTML = Array.from({ length: totalSlides }, (_, idx) =>
                `<button type="button" data-slide="${idx}" aria-label="Slide ${idx + 1}" class="testimonial-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${idx === 0 ? 'w-6 bg-[#214080]' : 'w-2 bg-gray-300 hover:bg-gray-400'}"></button>`
            ).join('');
        }

        function updateTestimonialSlider(index) {
            slideIndex = (index + totalSlides) % totalSlides;
            // Dịch chuyển track sang trái (-100% * slideIndex) -> tạo hiệu ứng slide mới chạy từ phải sang trái
            testimonialTrack.style.transform = `translateX(-${slideIndex * 100}%)`;

            if (dotsContainer) {
                dotsContainer.querySelectorAll('.testimonial-dot').forEach((dot, idx) => {
                    if (idx === slideIndex) {
                        dot.classList.remove('w-2', 'bg-gray-300');
                        dot.classList.add('w-6', 'bg-[#214080]');
                    } else {
                        dot.classList.remove('w-6', 'bg-[#214080]');
                        dot.classList.add('w-2', 'bg-gray-300');
                    }
                });
            }
        }

        function startAutoSlide() {
            stopAutoSlide();
            autoSlideTimer = setInterval(() => {
                updateTestimonialSlider(slideIndex + 1);
            }, 5000); // Tự động chuyển sau mỗi 5 giây
        }

        function stopAutoSlide() {
            if (autoSlideTimer) {
                clearInterval(autoSlideTimer);
                autoSlideTimer = null;
            }
        }

        // Sự kiện nút Prev / Next
        prevTestimonialBtn?.addEventListener('click', () => {
            updateTestimonialSlider(slideIndex - 1);
            startAutoSlide();
        });

        nextTestimonialBtn?.addEventListener('click', () => {
            updateTestimonialSlider(slideIndex + 1);
            startAutoSlide();
        });

        // Sự kiện bấm vào từng chấm dot
        dotsContainer?.addEventListener('click', (e) => {
            const dot = e.target.closest('.testimonial-dot');
            if (!dot) return;
            updateTestimonialSlider(parseInt(dot.dataset.slide, 10));
            startAutoSlide();
        });

        // Tạm dừng khi rê chuột vào slider để khách dễ đọc, tiếp tục chạy khi rời chuột
        testimonialWrapper?.addEventListener('mouseenter', stopAutoSlide);
        testimonialWrapper?.addEventListener('mouseleave', startAutoSlide);

        // Khởi chạy tự động
        startAutoSlide();
    }
</script>