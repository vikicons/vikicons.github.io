---
import Layout from '../layouts/layout.astro';

// ============================================================
// DỮ LIỆU DỰ ÁN
// Thêm dự án mới = thêm 1 object ở đây + thêm titleKey vào vi.json và en.json
// ============================================================
const projects = [
    { id: 1,  titleKey: "proj_ksp_title",       title: "Nhà Máy KSP Việt Nam Chi Nhánh Hải Dương",                         category: "industrial", region: "north",   image: "/img/nhaMayKspHaiDuong001.png" },
    { id: 2,  titleKey: "proj_aac_vp_title",    title: "Nhà Máy Sản Xuất Linh Kiện Điện Tử AAC Vĩnh Phúc",                 category: "industrial", region: "north",   image: "/img/nhaMayAacVinhPhuc001.png" },
    { id: 3,  titleKey: "proj_cp_bd_title",     title: "Nhà Máy Giết Mổ CP Bình Định",                                     category: "industrial", region: "central", image: "/img/nhaMayBff001.png" },
    { id: 4,  titleKey: "proj_aac_bg_title",    title: "Nhà Máy Sản Xuất Linh Kiện Điện Tử AAC Bắc Giang",                 category: "industrial", region: "north",   image: "/img/nhaMayAacBacGiang001.png" },
    { id: 5,  titleKey: "proj_cp_bp_title",     title: "Toà Văn Phòng Nhà Máy CP Bình Phước",                              category: "industrial", region: "south",   image: "/img/trangTraiVinhTanBinhDuong001.png" },
    { id: 6,  titleKey: "proj_chiatai_title",   title: "Nhà Máy Chia Tải Long An",                                         category: "industrial", region: "south",   image: "/img/nhaMayKspHaiDuong001.png" },
    { id: 7,  titleKey: "proj_nhaxe_bt_title",  title: "Nhà Xe 5 Tầng Bến Tre",                                            category: "industrial", region: "south",   image: "/img/nhaMayAacVinhPhuc001.png" },
    { id: 8,  titleKey: "proj_greenfeed_title", title: "Thi Công Xây Dựng Soft Stock Greenfeed Bình Định",                 category: "industrial", region: "central", image: "/img/nhaMayAacBacGiang001.png" },
    { id: 9,  titleKey: "proj_aac_bg2_title",   title: "Nhà Máy Sản Xuất Linh Kiện Điện Tử AAC Bắc Giang (Giai đoạn II)",  category: "industrial", region: "north",   image: "/img/nhaMayKspHaiDuong001.png" },
    { id: 10, titleKey: "proj_vinhtan_title",   title: "Trang Trại Chăn Nuôi Vĩnh Tân 7, 8, 9 Bình Dương",                 category: "livestock",  region: "south",   image: "/img/trangTraiVinhTanBinhDuong001.png" },
    { id: 11, titleKey: "proj_hoaphat_title",   title: "Trang Trại Chăn Nuôi Hoà Phát Bình Phước",                         category: "livestock",  region: "south",   image: "/img/nhaMayAacVinhPhuc001.png" },
    { id: 12, titleKey: "proj_viki_farm_title", title: "Trang Trại Chăn Nuôi VIKI Bình Phước",                             category: "livestock",  region: "south",   image: "/img/nhaMayAacBacGiang001.png" }
];

// Khoá i18n cho tag trên card
const SECTOR_KEYS = { industrial: 'tag_industrial_zone', livestock: 'tag_livestock' };
const REGION_KEYS = { north: 'region_north', central: 'region_central', south: 'region_south' };

// ============================================================
// NẠP TỪ ĐIỂN vi.json / en.json NGAY LÚC BUILD (chỉ lấy các key trang này cần)
// Tự tìm file vi.json, en.json ở bất kỳ thư mục nào trong /src
// ============================================================
const dictFiles = import.meta.glob('/src/**/{vi,en}.json', { eager: true, import: 'default' });
const neededKeys = new Set([
    'projects_page_title',
    ...projects.map(p => p.titleKey),
    ...Object.values(SECTOR_KEYS),
    ...Object.values(REGION_KEYS)
]);
const i18nDict = {};
for (const [path, json] of Object.entries(dictFiles)) {
    const code = path.split('/').pop().replace('.json', '');
    i18nDict[code] = Object.fromEntries(Object.entries(json).filter(([k]) => neededKeys.has(k)));
}
---

<Layout title="Các Dự Án | VIKI Construction Corporation">

    <div class="bg-[#FAF9F9] min-h-screen py-12">
        <div class="container mx-auto px-4">

            <!-- PAGE TITLE -->
            <div class="mb-8">
                <h1 id="projects-page-title" class="text-[59px] font-extrabold uppercase tracking-tight leading-[1.15] mb-6" data-key="projects_page_title">CÁC DỰ ÁN</h1>
                <div class="w-16 h-1 bg-[#ED2424] mt-3"></div>
            </div>

            <!-- FEATURED PROJECT BANNER (Dự án biểu tượng) -->
            <div class="relative rounded-xl overflow-hidden shadow-2xl mb-12 bg-[#16315E] group">
                <div class="h-[380px] sm:h-[480px] w-full overflow-hidden relative">
                    <img src="/img/nhaMayBff001.png" alt="Nhà máy và Kho BFF" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" onerror="this.onerror=null; this.src='/img/slide001.webp';">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
                </div>
                <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-10 text-white flex flex-col md:flex-row md:items-end justify-between gap-6">
                    <div>
                        <div class="text-xs sm:text-sm font-bold uppercase tracking-widest text-[#5FD1C1] mb-2" data-key="proj_featured_tag">Dự án biểu tượng — Trọng điểm 2025-2026</div>
                        <h2 class="text-2xl sm:text-4xl font-extrabold uppercase mb-2 tracking-wide" data-key="proj_bff_title">NHÀ MÁY VÀ KHO BFF</h2>
                        <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed m-0" data-key="proj_bff_desc">
                            Khu công nghiệp Tân Bình, TP.HCM | Giá trị hợp đồng: 242,5 tỷ VNĐ | Quy mô tổng thể đáp ứng không gian sản xuất và lưu trữ tiên tiến.
                        </p>
                    </div>
                    <a href="/services" class="inline-flex items-center justify-center gap-2 bg-[#264ABC] hover:bg-[#16315E] text-white px-6 py-3 text-xs sm:text-sm font-bold uppercase tracking-wider transition no-underline border border-white/20 whitespace-nowrap shadow-lg">
                        <span data-key="btn_view_detail">XEM CHI TIẾT</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </a>
                </div>
            </div>

            <!-- MAIN CONTENT WRAPPER -->
            <div id="main-content-wrapper" class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16" style="overflow-anchor: none;">

                <!-- CỘT TRÁI: SIDEBAR BỘ LỌC -->
                <div class="lg:col-span-3">

                    <!-- 1. GIAO DIỆN MOBILE, FOLDABLES & IPAD (Dưới màn hình lg: < 1024px) -->
                    <div class="block lg:hidden bg-white p-3 sm:p-4 rounded-xl border border-[#E6EAF2] shadow-sm space-y-2">
                        
                        <!-- Tiêu đề Dự án biểu tượng (Không phải nút chọn trạng thái lọc) -->
                        <div class="pb-2 border-b border-[#E6EAF2]">
                            <div class="text-xs font-extrabold uppercase tracking-wider text-[#16315E]" data-key="proj_sidebar_featured">Featured Project</div>
                        </div>

                        <!-- Nhóm 1: Nút chọn trạng thái (Mặc định "All Projects" được chọn nền xanh chữ trắng) -->
                        <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none pt-1">
                            <button type="button" data-filter="all" class="filter-btn shrink-0 text-xs font-bold px-3 py-1.5 rounded-lg bg-[#214080] text-white transition shadow-sm border border-[#214080]" data-key="proj_sidebar_all">All Projects</button>
                        </div>

                        <!-- Nhóm 2: Lọc theo Lĩnh vực (By Sector) -->
                        <div class="pt-1.5 border-t border-[#E6EAF2]">
                            <div class="text-[11px] font-bold text-[#16315E] uppercase tracking-wider mb-1" data-key="proj_sector_title">By Sector</div>
                            <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none">
                                <button type="button" data-filter="industrial" class="filter-btn shrink-0 text-xs font-medium px-2.5 py-1 rounded-md bg-[#FAF9F9] border border-[#E6EAF2] text-[#5A6E85] hover:text-[#214080] transition" data-key="sector_industrial">Industrial Park</button>
                                <button type="button" data-filter="livestock" class="filter-btn shrink-0 text-xs font-medium px-2.5 py-1 rounded-md bg-[#FAF9F9] border border-[#E6EAF2] text-[#5A6E85] hover:text-[#214080] transition" data-key="sector_livestock">Livestock Infrastructure</button>
                            </div>
                        </div>

                        <!-- Nhóm 3: Lọc theo Khu vực (By Region) -->
                        <div class="pt-1.5 border-t border-[#E6EAF2]">
                            <div class="text-[11px] font-bold text-[#16315E] uppercase tracking-wider mb-1" data-key="proj_region_title">By Region</div>
                            <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none">
                                <button type="button" data-filter="north" class="filter-btn shrink-0 text-xs font-medium px-2.5 py-1 rounded-md bg-[#FAF9F9] border border-[#E6EAF2] text-[#5A6E85] hover:text-[#214080] transition" data-key="region_north">Northern Region</button>
                                <button type="button" data-filter="central" class="filter-btn shrink-0 text-xs font-medium px-2.5 py-1 rounded-md bg-[#FAF9F9] border border-[#E6EAF2] text-[#5A6E85] hover:text-[#214080] transition" data-key="region_central">Central Region</button>
                                <button type="button" data-filter="south" class="filter-btn shrink-0 text-xs font-medium px-2.5 py-1 rounded-md bg-[#FAF9F9] border border-[#E6EAF2] text-[#5A6E85] hover:text-[#214080] transition" data-key="region_south">Southern Region</button>
                            </div>
                        </div>

                    </div>

                    <!-- 2. GIAO DIỆN DESKTOP / LAPTOP (Từ màn hình lg: >= 1024px trở lên) -->
                    <aside id="sticky-sidebar" class="hidden lg:block bg-white p-6 rounded-xl border border-[#E6EAF2] shadow-sm space-y-6" style="position: sticky; top: calc(var(--header-h, 96px) + 8px);">
                        <div>
                            <div class="text-sm font-extrabold uppercase tracking-wider text-[#16315E] mb-3" data-key="proj_sidebar_featured">Featured Project</div>
                            
                            <ul class="space-y-3 font-medium list-none p-0 m-0">
                                <li>
                                    <!-- Nút All Projects mặc định khi vào trang -->
                                    <button type="button" data-filter="all" class="filter-btn text-[#214080] font-bold transition text-left w-full bg-transparent p-0 cursor-pointer border-0 border-l-[3px] border-solid border-[#214080] pl-3 text-sm" data-key="proj_sidebar_all">All Projects</button>
                                </li>
                            </ul>
                        </div>

                        <div class="pt-4 border-t border-[#E6EAF2]">
                            <h4 class="text-sm font-bold text-[#16315E] uppercase tracking-wider mb-3" data-key="proj_sector_title">By Sector</h4>
                            <ul class="space-y-2.5 text-sm text-[#5A6E85] list-none p-0 m-0">
                                <li><button type="button" data-filter="industrial" class="filter-btn text-[#5A6E85] hover:text-[#214080] transition text-left w-full bg-transparent border-0 p-0 cursor-pointer text-sm" data-key="sector_industrial">Industrial Park</button></li>
                                <li><button type="button" data-filter="livestock" class="filter-btn text-[#5A6E85] hover:text-[#214080] transition text-left w-full bg-transparent border-0 p-0 cursor-pointer text-sm" data-key="sector_livestock">Livestock Infrastructure</button></li>
                            </ul>
                        </div>

                        <div class="pt-4 border-t border-[#E6EAF2]">
                            <h4 class="text-sm font-bold text-[#16315E] uppercase tracking-wider mb-3" data-key="proj_region_title">By Region</h4>
                            <ul class="space-y-2.5 text-sm text-[#5A6E85] list-none p-0 m-0">
                                <li><button type="button" data-filter="north" class="filter-btn text-[#5A6E85] hover:text-[#214080] transition text-left w-full bg-transparent border-0 p-0 cursor-pointer text-sm" data-key="region_north">Northern Region</button></li>
                                <li><button type="button" data-filter="central" class="filter-btn text-[#5A6E85] hover:text-[#214080] transition text-left w-full bg-transparent border-0 p-0 cursor-pointer text-sm" data-key="region_central">Central Region</button></li>
                                <li><button type="button" data-filter="south" class="filter-btn text-[#5A6E85] hover:text-[#214080] transition text-left w-full bg-transparent border-0 p-0 cursor-pointer text-sm" data-key="region_south">Southern Region</button></li>
                            </ul>
                        </div>
                    </aside>

                </div>

                <!-- CỘT PHẢI: LƯỚI DỰ ÁN & PHÂN TRANG -->
                <div id="right-content-column" class="lg:col-span-9 space-y-8">
                    <div id="project-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <!-- Các card dự án render bằng JS -->
                    </div>

                    <div id="pagination-container" class="flex items-center justify-center gap-2 pt-4">
                        <!-- Nút phân trang render bằng JS -->
                    </div>
                </div>

            </div>

            <!-- SECTION: KHÁCH HÀNG NÓI GÌ VỀ VIKI -->
            <div class="bg-white rounded-xl p-6 sm:p-10 border border-[#E6EAF2] shadow-sm mt-16">
                <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-8 pb-0 border-b border-gray-100">
                    <h2 class="text-2xl sm:text-3xl font-extrabold uppercase text-[#16315E] m-0 tracking-wide" data-key="testimonial_title">
                        KHÁCH HÀNG NÓI GÌ VỀ VIKI?
                    </h2>
                    <div class="flex items-center gap-2">
                        <button type="button" id="testimonial-prev" aria-label="Previous testimonial" class="w-10 h-10 rounded-full border border-gray-300 flex items-center justify-center text-[#214080] hover:bg-[#214080] hover:text-white transition cursor-pointer">&larr;</button>
                        <button type="button" id="testimonial-next" aria-label="Next testimonial" class="w-10 h-10 rounded-full border border-gray-300 flex items-center justify-center text-[#214080] hover:bg-[#214080] hover:text-white transition cursor-pointer">&rarr;</button>
                    </div>
                </div>

                <!-- KHUNG SLIDER (Ẩn phần tràn ngang để tạo hiệu ứng trượt phải -> trái) -->
                <div id="testimonial-slider-wrapper" class="overflow-hidden relative my-10 sm:my-4">
                    <div id="testimonial-track" class="flex transition-transform duration-700 ease-in-out">

                        <!-- KHÁCH HÀNG 1 (Gốc) -->
                        <div class="w-full shrink-0 px-2 sm:px-4">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                                <div class="lg:col-span-3 flex justify-center">
                                    <div class="relative rounded-lg overflow-hidden shadow-md w-full max-w-[260px] aspect-square bg-slate-200">
                                        <img src="/khachHang.png" alt="Đại diện Ban Quản lý Dự án Đầu tư" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/img/slide001.webp';">
                                        <div class="absolute bottom-2 left-2 w-5 h-5 border-l-2 border-b-2 border-[#5FD1C1]"></div>
                                    </div>
                                </div>
                                <div class="lg:col-span-9 space-y-4">
                                    <blockquote class="text-base text-[#5A6E85] italic text-justify leading-relaxed m-0 border-l-4 border-[#214080] pl-5 pr-5" data-key="testimonial_quote_1">
                                        "Chất lượng xây dựng và năng lực điều hành dự án của VIKI được thể hiện rất rõ ràng ở các công trình thực tế. Đội ngũ kỹ sư làm việc tận tâm, chuyên nghiệp, giữ vững cam kết về tiến độ và tiêu chuẩn kỹ thuật khắt khe. Chúng tôi vô cùng hài lòng và mong muốn tiếp tục hợp tác trong các dự án quy mô lớn tiếp theo."
                                    </blockquote>
                                    <div class="pt-2">
                                        <div class="text-sm font-bold text-[#16315E] uppercase" data-key="testimonial_pos_1">ĐẠI DIỆN BAN QUẢN LÝ DỰ ÁN ĐẦU TƯ</div>
                                        <div class="text-xs text-[#5A6E85] mt-1" data-key="testimonial_desc_1">Đối tác chiến lược & Chủ đầu tư các khu công nghiệp trọng điểm</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- KHÁCH HÀNG 2 -->
                        <div class="w-full shrink-0 px-2 sm:px-4">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                                <div class="lg:col-span-3 flex justify-center">
                                    <div class="relative rounded-lg overflow-hidden shadow-md w-full max-w-[260px] aspect-square bg-slate-200">
                                        <img src="/khachHang2.png" alt="Giám đốc Khối Hạ tầng Công nghiệp" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/img/slide001.webp';">
                                        <div class="absolute bottom-2 left-2 w-5 h-5 border-l-2 border-b-2 border-[#5FD1C1]"></div>
                                    </div>
                                </div>
                                <div class="lg:col-span-9 space-y-4">
                                    <blockquote class="text-base text-[#5A6E85] italic   text-justify leading-relaxed m-0 border-l-4 border-[#214080] pl-5 pr-5" data-key="testimonial_quote_2">
                                        "VIKI đã chứng minh năng lực thi công tổng thầu vượt trội trong gói thầu mở rộng nhà xưởng sản xuất linh kiện điện tử của chúng tôi. Công tác an toàn lao động và kiểm soát chất lượng vật tư được thực hiện bài bản, giúp nhà máy đi vào vận hành đúng kế hoạch."
                                    </blockquote>
                                    <div class="pt-2">
                                        <div class="text-sm font-bold text-[#16315E] uppercase" data-key="testimonial_pos_2">GIÁM ĐỐC KHỐI HẠ TẦNG & XÂY DỰNG</div>
                                        <div class="text-xs text-[#5A6E85] mt-1" data-key="testimonial_desc_2">Tập đoàn Sản xuất Linh kiện Điện tử Công nghệ cao</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- KHÁCH HÀNG 3 -->
                        <div class="w-full shrink-0 px-2 sm:px-4">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                                <div class="lg:col-span-3 flex justify-center">
                                    <div class="relative rounded-lg overflow-hidden shadow-md w-full max-w-[260px] aspect-square bg-slate-200">
                                        <img src="/khachHang3.png" alt="Trưởng ban Phát triển Trang trại Chăn nuôi" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/img/slide001.webp';">
                                        <div class="absolute bottom-2 left-2 w-5 h-5 border-l-2 border-b-2 border-[#5FD1C1]"></div>
                                    </div>
                                </div>
                                <div class="lg:col-span-9 space-y-4">
                                    <blockquote class="text-base text-[#5A6E85] italic   text-justify leading-relaxed m-0 border-l-4 border-[#214080] pl-5 pr-5" data-key="testimonial_quote_3">
                                        "Với đặc thù khắt khe về an toàn sinh học và kết cấu hạ tầng nông nghiệp công nghệ cao, VIKI đã đưa ra các giải pháp kỹ thuật tối ưu, tiết kiệm chi phí vận hành dài hạn. Sự phối hợp nhịp nhàng giữa ban chỉ huy công trường và chủ đầu tư là điểm cộng rất lớn."
                                    </blockquote>
                                    <div class="pt-2">
                                        <div class="text-sm font-bold text-[#16315E] uppercase" data-key="testimonial_pos_3">TRƯỞNG BAN PHÁT TRIỂN DỰ ÁN NÔNG NGHIỆP</div>
                                        <div class="text-xs text-[#5A6E85] mt-1" data-key="testimonial_desc_3">Doanh nghiệp Đầu tư Hệ thống Trang trại & Chế biến Thực phẩm</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- KHÁCH HÀNG 4 -->
                        <div class="w-full shrink-0 px-2 sm:px-4">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                                <div class="lg:col-span-3 flex justify-center">
                                    <div class="relative rounded-lg overflow-hidden shadow-md w-full max-w-[260px] aspect-square bg-slate-200">
                                        <img src="/khachHang4.png" alt="Giám đốc Vận hành Chuỗi Kho vận" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/img/slide001.webp';">
                                        <div class="absolute bottom-2 left-2 w-5 h-5 border-l-2 border-b-2 border-[#5FD1C1]"></div>
                                    </div>
                                </div>
                                <div class="lg:col-span-9 space-y-4">
                                    <blockquote class="text-base text-[#5A6E85]   italic text-justify leading-relaxed m-0 border-l-4 border-[#214080] pl-5 pr-5" data-key="testimonial_quote_4">
                                        "Hệ thống nhà kho tiêu chuẩn và hạ tầng kỹ thuật đồng bộ do VIKI thi công đáp ứng trọn vẹn các tiêu chuẩn quốc tế về tải trọng sàn và phòng cháy chữa cháy. Chúng tôi đánh giá cao tinh thần trách nhiệm và sự minh bạch trong suốt quá trình triển khai dự án."
                                    </blockquote>
                                    <div class="pt-2">
                                        <div class="text-sm font-bold text-[#16315E] uppercase" data-key="testimonial_pos_4">GIÁM ĐỐC VẬN HÀNH & LOGISTICS</div>
                                        <div class="text-xs text-[#5A6E85] mt-1" data-key="testimonial_desc_4">Công ty Cổ phần Kho vận & Trung tâm Phân phối Miền Nam</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- KHÁCH HÀNG 5 -->
                        <div class="w-full shrink-0 px-2 sm:px-4">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                                <div class="lg:col-span-3 flex justify-center">
                                    <div class="relative rounded-lg overflow-hidden shadow-md w-full max-w-[260px] aspect-square bg-slate-200">
                                        <img src="/khachHang5.png" alt="Đại diện Chủ đầu tư Khu công nghiệp" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/img/slide001.webp';">
                                        <div class="absolute bottom-2 left-2 w-5 h-5 border-l-2 border-b-2 border-[#5FD1C1]"></div>
