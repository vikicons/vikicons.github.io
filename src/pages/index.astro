    <!-- PAGE-SPECIFIC SCRIPT -->
    <script>
        let currentSlide = 0;
        const totalSlides = 3;
        const slideDuration = 6000;
        let slideTimer = null;

        function initDots() {
            const dotsContainer = document.getElementById('dotsContainer');
            if (!dotsContainer) return;
            dotsContainer.innerHTML = '';
            
            for (let i = 0; i < totalSlides; i++) {
                const dot = document.createElement('div');
                dot.className = 'dot-item relative h-[8px] rounded-full cursor-pointer overflow-hidden transition-all duration-500 ease-in-out bg-white/50';
                dot.style.width = (i === currentSlide) ? '32px' : '8px';
                if (i === currentSlide) {
                    dot.classList.replace('bg-white/50', 'bg-white/30');
                }

                const bar = document.createElement('div');
                bar.className = 'progress-bar absolute top-0 left-0 bottom-0 bg-white rounded-full';
                bar.style.width = '0%';

                dot.onclick = () => window.goToSlide(i);
                dot.appendChild(bar);
                dotsContainer.appendChild(dot);
            }
            updateProgressBars();
        }

        function updateProgressBars() {
            const dotsContainer = document.getElementById('dotsContainer');
            if (!dotsContainer) return;
            const dots = dotsContainer.children;

            for (let i = 0; i < dots.length; i++) {
                const dot = dots[i];
                const bar = dot.children[0];

                if (i === currentSlide) {
                    dot.style.width = '32px';
                    dot.className = 'dot-item relative h-[8px] rounded-full cursor-pointer overflow-hidden transition-all duration-500 ease-in-out bg-white/30';
                    
                    bar.style.transition = 'none';
                    bar.style.width = '0%';
                    void bar.offsetWidth;
                    bar.style.transition = `width ${slideDuration}ms linear`;
                    bar.style.width = '100%';
                } else {
                    dot.style.width = '8px';
                    dot.className = 'dot-item relative h-[8px] rounded-full cursor-pointer overflow-hidden transition-all duration-500 ease-in-out bg-white/50';
                    
                    bar.style.transition = 'width 0.2s ease-out';
                    bar.style.width = '0%';
                }
            }
        }

        function updateSlide() {
            for (let i = 0; i < totalSlides; i++) {
                const slide = document.getElementById(`slide-${i}`);
                if (slide) {
                    if (i === currentSlide) {
                        slide.style.opacity = '1';
                        slide.style.pointerEvents = 'auto';
                    } else {
                        slide.style.opacity = '0';
                        slide.style.pointerEvents = 'none';
                    }
                }
            }
            updateProgressBars();
        }

        function startTimer() {
            clearInterval(slideTimer);
            slideTimer = setInterval(() => {
                nextSlide();
            }, slideDuration);
        }

        function nextSlide() {
            currentSlide = (currentSlide + 1) % totalSlides;
            updateSlide();
            startTimer();
        }

        function prevSlide() {
            currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
            updateSlide();
            startTimer();
        }

        window.goToSlide = function(index) {
            if (currentSlide === index) return;
            currentSlide = index;
            updateSlide();
            startTimer();
        };

        document.getElementById('nextSlideBtn')?.addEventListener('click', nextSlide);
        document.getElementById('prevSlideBtn')?.addEventListener('click', prevSlide);

        function initDynamicYears() {
            const foundingYear = 2020;
            const currentYear = new Date().getFullYear();
            const yearsCount = currentYear - foundingYear;
            
            const yearEl = document.getElementById('counter-years');
            if (yearEl) {
                yearEl.setAttribute('data-target', yearsCount);
                yearEl.innerText = '0';
            }
        }

        function animateCounter(el, target, suffix = '', duration = 1800) {
            let start = 0;
            if (target <= 9) {
                const steps = target > 0 ? target : 1;
                const stepTime = Math.floor(2000 / steps);

                const timer = setInterval(() => {
                    start += 1;
                    if (start >= target) {
                        start = target;
                        clearInterval(timer);
                    }
                    el.innerText = start;
                }, stepTime);
            } else {
                const steps = 40;
                const stepValue = target / steps;
                const stepTime = Math.floor(duration / steps);

                const timer = setInterval(() => {
                    start += stepValue;
                    if (start >= target) {
                        start = target;
                        clearInterval(timer);
                    }
                    el.innerText = Math.floor(start).toLocaleString() + suffix;
                }, stepTime);
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            initDots();
            updateSlide();
            startTimer();
            initDynamicYears();

            const aboutSection = document.getElementById('about');
            let hasAnimated = false;

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting && !hasAnimated) {
                        hasAnimated = true;
                        
                        const yearEl = document.getElementById('counter-years');
                        if (yearEl) {
                            const targetYears = parseInt(yearEl.getAttribute('data-target')) || 6;
                            animateCounter(yearEl, targetYears);
                        }

                        const pEl = document.getElementById('counter-projects');
                        const partnersEl = document.getElementById('counter-partners');
                        const sEl = document.getElementById('counter-staff');
                        const provincesEl = document.getElementById('counter-provinces');

                        if (pEl) animateCounter(pEl, parseInt(pEl.getAttribute('data-target')), ' +');
                        if (partnersEl) animateCounter(partnersEl, parseInt(partnersEl.getAttribute('data-target')), ' +');
                        if (sEl) animateCounter(sEl, parseInt(sEl.getAttribute('data-target')), ' +');
                        if (provincesEl) animateCounter(provincesEl, parseInt(provincesEl.getAttribute('data-target')), ' +');
                    }
                });
            }, { threshold: 0.25 });

            if (aboutSection) {
                observer.observe(aboutSection);
            }

            // Khởi tạo trạng thái ban đầu: Chỉ mở Mục 1, các mục còn lại đóng hoàn toàn
            const serviceItems = document.querySelectorAll('.service-item');
            serviceItems.forEach((item, index) => {
                const content = item.querySelector('.service-content');
                if (!content) return;
                if (index === 0) {
                    item.classList.add('active');
                    content.style.maxHeight = content.scrollHeight + "px";
                } else {
                    item.classList.remove('active');
                    content.style.maxHeight = '0px';
                }
            });
        });

        // --- XỬ LÝ HIỆU ỨNG CARD "CHÚNG TÔI LÀM GÌ?" TRÊN MOBILE & PC ---
        const wwdCards = document.querySelectorAll('.wwd-card');

        wwdCards.forEach(card => {
            const toggleBtn = card.querySelector('.wwd-mobile-toggle');
            const toggleText = card.querySelector('.wwd-toggle-text');

            toggleBtn?.addEventListener('click', (e) => {
                if (window.innerWidth < 1024) {
                    e.preventDefault();
                    const isOpen = card.classList.contains('mobile-active');

                    // Đóng tất cả các card khác
                    wwdCards.forEach(c => {
                        c.classList.remove('mobile-active');
                        const txt = c.querySelector('.wwd-toggle-text');
                        if (txt) {
                            txt.innerHTML = 'Xem thêm <span class="w-6 h-6 flex items-center justify-center bg-white/20 rounded text-base font-bold">+</span>';
                        }
                    });

                    // Mở card hiện tại nếu chưa mở
                    if (!isOpen) {
                        card.classList.add('mobile-active');
                        if (toggleText) {
                            toggleText.innerHTML = 'Thu gọn <span class="w-6 h-6 flex items-center justify-center bg-white/20 rounded text-base font-bold">-</span>';
                        }
                    }
                }
            });
        });

        // --- XỬ LÝ TƯƠNG TÁC ACCORDION TRƯỢT MƯỢT MÀ & ĐỔI ẢNH ---
        const serviceItems = document.querySelectorAll('.service-item');
        const dynamicImage = document.getElementById('service-dynamic-image');

        serviceItems.forEach(item => {
            const header = item.querySelector('.service-header');
            if (!header) return;

            header.addEventListener('click', () => {
                const isActive = item.classList.contains('active');
                if (isActive) return;

                serviceItems.forEach(i => {
                    i.classList.remove('active');
                    const h = i.querySelector('.service-header');
                    const ic = i.querySelector('.toggle-icon');
                    const ct = i.querySelector('.service-content');

                    if (h) {
                        h.className = 'service-header w-full flex justify-between items-center p-[20px] text-left bg-white text-[#16315E] hover:bg-slate-50 transition-colors cursor-pointer border-none';
                    }
                    if (ic) {
                        ic.innerText = '+';
                        ic.className = 'toggle-icon text-xl font-bold w-8 h-8 flex items-center justify-center bg-[#E6EAF2] text-[#16315E] rounded';
                    }
                    if (ct) {
                        ct.style.maxHeight = '0px'; // Đóng mượt mà
                    }
                });

                item.classList.add('active');
                header.className = 'service-header w-full flex justify-between items-center p-[20px] text-left bg-[#264ABC] text-white transition-colors cursor-pointer border-none';
                
                const icon = item.querySelector('.toggle-icon');
                if (icon) {
                    icon.innerText = '-';
                    icon.className = 'toggle-icon text-xl font-bold w-8 h-8 flex items-center justify-center bg-white/20 text-white rounded';
                }
                
                const content = item.querySelector('.service-content');
                if (content) {
                    content.style.maxHeight = content.scrollHeight + "px"; // Mở mượt mà theo chiều cao thực tế
                }

                const newImgUrl = item.getAttribute('data-image');
                if (newImgUrl && dynamicImage) {
                    dynamicImage.style.opacity = '0';
                    setTimeout(() => {
                        dynamicImage.src = newImgUrl;
                        dynamicImage.style.opacity = '1';
                    }, 200);
                }
            });
        });

        // --- XỬ LÝ HIỆU ỨNG ACCORDION & HOVER DỰ ÁN BIỂU TƯỢNG ---
        const projectCards = document.querySelectorAll('.featured-projects-container .project-card');

        projectCards.forEach(card => {
            // 1. Hiệu ứng hover mở rộng trên PC
            card.addEventListener('mouseenter', () => {
                if (window.innerWidth >= 1024) {
                    // Nếu card này đã active rồi thì không làm gì cả để tránh trigger lại layout trượt trang
                    if (card.classList.contains('active')) return;

                    projectCards.forEach(c => c.classList.remove('active'));
                    card.classList.add('active');
                }
            });

            // 2. Hiệu ứng Thu gọn / Xem thêm trên Mobile
            const mobileToggleBtn = card.querySelector('.mobile-toggle-btn');
            mobileToggleBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                if (window.innerWidth < 1024) {
                    const isExpanded = card.classList.contains('mobile-expanded');
                    const scrollPosition = window.pageYOffset;

                    projectCards.forEach(c => {
                        c.classList.remove('mobile-expanded');
                        const txt = c.querySelector('.toggle-text');
                        const icon = c.querySelector('.toggle-icon');
                        if (txt) txt.innerText = 'Xem thêm';
                        if (icon) icon.innerText = '+';
                    });

                    if (!isExpanded) {
                        card.classList.add('mobile-expanded');
                        const txt = card.querySelector('.toggle-text');
                        const icon = card.querySelector('.toggle-icon');
                        if (txt) txt.innerText = 'Thu gọn';
                        if (icon) icon.innerText = '-';

                        setTimeout(() => {
                            const cardRect = card.getBoundingClientRect();
                            if (cardRect.top < 0 || cardRect.bottom > window.innerHeight) {
                                card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                            }
                        }, 50);
                    } else {
                        window.scrollTo(0, scrollPosition);
                    }
                }
            });
        });

        // Khởi tạo mặc định mở card đầu tiên trên mobile
        if (window.innerWidth < 1024 && projectCards.length > 0) {
            projectCards[0].classList.add('mobile-expanded');
            const txt = projectCards[0].querySelector('.toggle-text');
            const icon = projectCards[0].querySelector('.toggle-icon');
            if (txt) txt.innerText = 'Thu gọn';
            if (icon) icon.innerText = '-';
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            // -------------------------------------------------------------
            // LOGIC ĐIỀU HƯỚNG SLIDER (NÚT TRÁI / PHẢI)
            // -------------------------------------------------------------
            const container = document.getElementById('esg-cards-container');
            const prevBtn = document.getElementById('esg-prev-btn');
            const nextBtn = document.getElementById('esg-next-btn');
            const cards = document.querySelectorAll('.esg-card');
            
            let currentIndex = 0;

            function getVisibleCardsCount() {
                return window.innerWidth >= 1024 ? 4 : 1;
            }

            function getMaxIndex() {
                return Math.max(0, cards.length - getVisibleCardsCount());
            }

            function updateSliderPosition() {
                if (cards.length === 0) return;
                const cardWidth = cards[0].offsetWidth;
                const gap = 24; // Khoảng cách gap-6 (1.5rem = 24px)
                const offset = currentIndex * (cardWidth + gap);
                container.style.transform = `translateX(-${offset}px)`;
            }

            nextBtn?.addEventListener('click', () => {
                if (currentIndex < getMaxIndex()) {
                    currentIndex++;
                } else {
                    currentIndex = 0; // Quay về đầu khi hết slide
                }
                updateSliderPosition();
            });

            prevBtn?.addEventListener('click', () => {
                if (currentIndex > 0) {
                    currentIndex--;
                } else {
                    currentIndex = getMaxIndex(); // Nhảy về cuối
                }
                updateSliderPosition();
            });

            window.addEventListener('resize', () => {
                if (currentIndex > getMaxIndex()) {
                    currentIndex = getMaxIndex();
                }
                updateSliderPosition();
            });

            // -------------------------------------------------------------
            // LOGIC ACCORDION DẠNG TEXT LINK + DẤU (+) TRÊN MOBILE
            // -------------------------------------------------------------
            cards.forEach(card => {
                const toggleBtn = card.querySelector('.esg-mobile-toggle');
                
                toggleBtn?.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (window.innerWidth < 1024) {
                        const isExpanded = card.classList.contains('mobile-expanded');
                        const scrollPos = window.pageYOffset;

                        // Thu gọn tất cả các card khác trước đó
                        cards.forEach(c => {
                            c.classList.remove('mobile-expanded');
                            const txt = c.querySelector('.toggle-text');
                            if (txt) txt.innerText = 'Xem thêm';
                        });

                        // Nếu chưa mở thì mở rộng card hiện tại
                        if (!isExpanded) {
                            card.classList.add('mobile-expanded');
                            const txt = card.querySelector('.toggle-text');
                            if (txt) txt.innerText = 'Thu gọn';

                            setTimeout(() => {
                                const rect = card.getBoundingClientRect();
                                if (rect.top < 0 || rect.bottom > window.innerHeight) {
                                    card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                                }
                            }, 50);
                        } else {
                            window.scrollTo(0, scrollPos);
                        }
                    }
                });
            });
        });

        // BAN TIN
        document.addEventListener("DOMContentLoaded", () => {
            const container = document.getElementById('news-slides-container');
            const slides = document.querySelectorAll('.news-mobile-slide');
            const prevBtn = document.getElementById('news-prev-btn');
            const nextBtn = document.getElementById('news-next-btn');
            const dots = document.querySelectorAll('.news-page-dot');

            if (!container || slides.length === 0) return;

            let currentIndex = 0;
            const totalSlides = slides.length;
            let slideInterval = null;

            const updateUI = () => {
                container.style.transform = `translateX(-${currentIndex * 100}%)`;
                dots.forEach((dot, idx) => {
                    const isActive = idx === currentIndex;
                    dot.className = `news-page-dot w-12 h-12 border flex items-center justify-center cursor-pointer font-bold transition-all ${
                        isActive 
                            ? "border-[#264ABC] bg-[#264ABC] text-white" 
                            : "border-[#E6EAF2] bg-white text-[#16315E] font-medium hover:bg-slate-50"
                    }`;
                });
            };

            const goToSlide = (index) => {
                currentIndex = (index + totalSlides) % totalSlides;
                updateUI();
            };

            const nextSlide = () => goToSlide(currentIndex + 1);
            const prevSlide = () => goToSlide(currentIndex - 1);

            const stopAutoplay = () => clearInterval(slideInterval);
            const startAutoplay = () => {
                stopAutoplay();
                slideInterval = setInterval(nextSlide, 5000);
            };

            // Event Listeners (DRY & Clean)
            nextBtn?.addEventListener('click', () => { nextSlide(); startAutoplay(); });
            prevBtn?.addEventListener('click', () => { prevSlide(); startAutoplay(); });

            dots.forEach((dot) => {
                dot.addEventListener('click', (e) => {
                    const index = parseInt(e.currentTarget.getAttribute('data-index'), 10);
                    if (!isNaN(index)) {
                        goToSlide(index);
                        startAutoplay();
                    }
                });
            });

            const sliderWrapper = document.querySelector('.news-mobile-slider');
            sliderWrapper?.addEventListener('mouseenter', stopAutoplay);
            sliderWrapper?.addEventListener('mouseleave', startAutoplay);

            startAutoplay();
        });

        // --- HIỆU ỨNG TỰ ĐỘNG ĐỔI ẢNH CHO CỤM "VỀ CHÚNG TÔI" ---
        const aboutImages1 = [
            "/img/veChungToi001.png",
            "/img/veChungToi005.png",
            "/img/veChungToi006.png",
            "/img/veChungToi008.png"
        ];
        const aboutImages2 = [
            "/img/veChungToi002.png",
            "/img/veChungToi003.png",
            "/img/veChungToi007.png",
            "/img/veChungToi004.png"
        ];

        let aboutIdx1 = 0;
        let aboutIdx2 = 0;

        const collageImg1 = document.getElementById('collage-img-1');
        const collageImg2 = document.getElementById('collage-img-2');

        if (collageImg1 && collageImg2) {
            setInterval(() => {
                // Đổi ảnh góc dưới bên trái
                aboutIdx1 = (aboutIdx1 + 1) % aboutImages1.length;
                collageImg1.style.opacity = '0';
                setTimeout(() => {
                    collageImg1.src = aboutImages1[aboutIdx1];
                    collageImg1.style.opacity = '1';
                }, 350);

                // Đổi ảnh lớn bên phải
                aboutIdx2 = (aboutIdx2 + 1) % aboutImages2.length;
                collageImg2.style.opacity = '0';
                setTimeout(() => {
                    collageImg2.src = aboutImages2[aboutIdx2];
                    collageImg2.style.opacity = '1';
                }, 350);
            }, 4500); // Thời gian chuyển ảnh mỗi 4.5 giây
        }
    </script>

</Layout>