---
import Layout from '../layouts/layout.astro';
---

<Layout title="VIKI - Công Ty Cổ Phần Xây Dựng  | Xây Giá Trị - Dựng Niềm Tin">

    <!-- HERO SLIDER SECTION (Chuẩn thiết kế VIKI Mega Banner) -->
    <section class="relative bg-[#16315E] text-white overflow-hidden" id="hero">
        <div class="relative min-h-[600px] md:min-h-[620px] flex items-center">
            
            <!-- Slide 1 -->
            <div class="hero-slide absolute inset-0 opacity-100 transition-opacity duration-700 flex items-center" id="slide-0">
                <img src="/img/slide001.png" alt="NHÀ MÁY CÔNG NGHỆ CAO" class="absolute inset-0 w-full h-full object-cover brightness-[0.5] contrast-110">
                
                <div class="container mx-auto px-4 sm:px-12 md:px-20 relative z-10 py-16 flex flex-col md:flex-row justify-between items-end h-full">
                    <div class="mb-10 md:mb-0">
                        <h2 class="text-3xl sm:text-6xl lg:text-7xl font-extrabold uppercase tracking-wider select-none leading-none">
                            <span class="text-white/80">INDUSTRIAL</span> <br />
                            <span class="text-blue-400/80">EXCELLENCE</span>
                        </h2>
                    </div>

                    <!-- Ô thông tin chuẩn VIKI -->
                    <div class="hero-info-box bg-[#264ABC] text-white p-6 md:p-[40px] w-full max-w-[420px] md:w-[314px] md:h-[380px] shadow-2xl relative border-l-4 border-[#5FD1C1] flex flex-col justify-between">
                        <div>
                            <div class="text-xs font-bold text-[#5FD1C1] tracking-widest mb-2">01 / 03</div>
                            <h3 class="text-2xl sm:text-3xl font-extrabold uppercase mb-3 tracking-wide">NHÀ MÁY CÔNG NGHỆ CAO</h3>
                            <p class="text-sm text-slate-100 leading-relaxed font-light line-clamp-4">
                                VIKI đảm nhận vai trò tổng thầu thiết kế và thi công các dự án nhà máy công nghiệp quy mô lớn, đạt chuẩn quốc tế với tốc độ thi công tối ưu và độ bền vững cao.
                            </p>
                        </div>
                        <div>
                            <a href="/projects" class="inline-flex items-center gap-3 text-xs font-bold uppercase tracking-widest text-white hover:text-[#5FD1C1] transition group pt-2">
                                <span>XEM CHI TIẾT</span>
                                <span class="text-base transition-transform group-hover:translate-x-1">↗</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2 -->
            <div class="hero-slide absolute inset-0 opacity-0 pointer-events-none transition-opacity duration-700 flex items-center" id="slide-1">
                <img src="/img/slide002.png" alt="Dự án Hạ tầng" class="absolute inset-0 w-full h-full object-cover brightness-[0.5] contrast-110">
                
                <div class="container mx-auto px-4 sm:px-12 md:px-20 relative z-10 py-16 flex flex-col md:flex-row justify-between items-end h-full">
                    <div class="mb-10 md:mb-0">
                        <h2 class="text-3xl sm:text-6xl lg:text-7xl font-extrabold uppercase tracking-wider select-none leading-none">
                            <span class="text-white/80">ADVANCED</span> <br />
                            <span class="text-blue-400/80">INFRASTRUCTURE</span>
                        </h2>
                    </div>

                    <div class="hero-info-box bg-[#264ABC] text-white p-6 md:p-[40px] w-full max-w-[420px] md:w-[314px] md:h-[380px] shadow-2xl relative border-l-4 border-[#5FD1C1] flex flex-col justify-between">
                        <div>
                            <div class="text-xs font-bold text-[#5FD1C1] tracking-widest mb-2">02 / 03</div>
                            <h3 class="text-2xl sm:text-3xl font-extrabold uppercase mb-3 tracking-wide">THIẾT BỊ & HẠ TẦNG HIỆN ĐẠI</h3>
                            <p class="text-sm text-slate-100 leading-relaxed font-light line-clamp-4">
                                Tiên phong ứng dụng các giải pháp thi công phát thải thấp, tối ưu hóa năng lượng và nguồn lực, hướng tới phát triển bền vững và bảo vệ môi trường toàn diện.
                            </p>
                        </div>
                        <div>
                            <a href="/projects" class="inline-flex items-center gap-3 text-xs font-bold uppercase tracking-widest text-white hover:text-[#5FD1C1] transition group pt-2">
                                <span>XEM CHI TIẾT</span>
                                <span class="text-base transition-transform group-hover:translate-x-1">↗</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div> 

            <!-- Slide 3 -->
            <div class="hero-slide absolute inset-0 opacity-0 pointer-events-none transition-opacity duration-700 flex items-center" id="slide-2">
                <img src="/img/slide003.png" alt="Cao ốc thương mại" class="absolute inset-0 w-full h-full object-cover brightness-[0.5] contrast-110">
                
                <div class="container mx-auto px-4 sm:px-12 md:px-20 relative z-10 py-16 flex flex-col md:flex-row justify-between items-end h-full">
                    <div class="mb-10 md:mb-0">
                        <h2 class="text-3xl sm:text-6xl lg:text-7xl font-extrabold uppercase tracking-wider select-none leading-none">
                            <span class="text-white/80">ASPIRING</span> <br />
                            <span class="text-blue-400/80">HORIZONS</span>
                        </h2>
                    </div>

                    <div class="hero-info-box bg-[#264ABC] text-white p-6 md:p-[40px] w-full max-w-[420px] md:w-[314px] md:h-[380px] shadow-2xl relative border-l-4 border-[#5FD1C1] flex flex-col justify-between">
                        <div>
                            <div class="text-xs font-bold text-[#5FD1C1] tracking-widest mb-2">03 / 03</div>
                            <h3 class="text-2xl sm:text-3xl font-extrabold uppercase mb-3 tracking-wide">QUY MÔ & TẦM NHÌN CHIẾN LƯỢC</h3>
                            <p class="text-sm text-slate-100 leading-relaxed font-light line-clamp-4">
                                Mở rộng quy mô đầu tư đa ngành nghề, phát triển các siêu dự án công nghiệp và nông nghiệp công nghệ cao, hướng tới mục tiêu vươn tầm top đầu doanh nghiệp phát triển bền vững vào năm 2040.
                            </p>
                        </div>
                        <div>
                            <a href="/projects" class="inline-flex items-center gap-3 text-xs font-bold uppercase tracking-widest text-white hover:text-[#5FD1C1] transition group pt-2">
                                <span>XEM CHI TIẾT</span>
                                <span class="text-base transition-transform group-hover:translate-x-1">↗</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- NÚT ĐIỀU HƯỚNG CĂN GIỮA 2 CẠNH TRÁI / PHẢI -->
            <button id="prevSlideBtn" class="absolute left-3 md:left-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full bg-white/30 backdrop-blur-sm border-2 border-[#264ABC] text-[#264ABC] hover:bg-[#264ABC] hover:text-white transition-all duration-300 flex items-center justify-center cursor-pointer shadow-lg" aria-label="Previous Slide">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>

            <button id="nextSlideBtn" class="absolute right-3 md:right-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full bg-white/30 backdrop-blur-sm border-2 border-[#264ABC] text-[#264ABC] hover:bg-[#264ABC] hover:text-white transition-all duration-300 flex items-center justify-center cursor-pointer shadow-lg" aria-label="Next Slide">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>

            <!-- THANH CHẤM PHÂN TRANG -->
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 bg-black/30 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/10" id="dotsContainer">
            </div>
        </div>
    </section>

    <!-- VỀ CHÚNG TÔI / ABOUT US (Header tiêu đề full-width ở trên cùng) -->
    <section class="relative bg-[#0F2854] text-white py-12 md:py-16 overflow-hidden border-t-6 border-[#FFC709]" id="about">
        <div class="max-w-[1250px] mx-auto px-6 sm:px-8 md:px-12 relative z-10">
            
            <!-- HEADER TIÊU ĐỀ FULL-WIDTH TRÊN CÙNG -->
            <div class="mb-6 md:mb-8">
                <div class="flex items-center gap-3">
                    <img src="/icon-hamburger-blue.png" alt="Icon" class="w-8 h-8 object-contain brightness-0 invert">
                    <div class="hidden items-end gap-[3px] h-6">
                        <span class="w-[3px] bg-white opacity-60 h-3"></span>
                        <span class="w-[3px] bg-white opacity-80 h-5"></span>
                        <span class="w-[3px] bg-white h-6"></span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl md:text-[32px] font-bold tracking-tight text-white leading-none uppercase">
                        VỀ CHÚNG TÔI
                    </h2>
                </div>
            </div>

            <!-- NỘI DUNG CHÍNH: LƯỚI 2 CỘT (Trái: Mô tả & Ảnh collage | Phải: Bảng số liệu) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
                
                <!-- CỘT TRÁI: Mô tả doanh nghiệp & Cụm ảnh bất đối xứng (Collage) -->
                <div class="lg:col-span-6 space-y-6">
                    <!-- Mô tả chọn lọc từ Thư ngỏ PDF VIKI -->
                    <p class="text-white text-base md:text-[16px] leading-relaxed font-normal text-justify max-w-xl">
                        Tuy mới thành lập nhưng doanh nghiệp đang từng bước khẳng định vai trò và vị trí của mình trong lĩnh vực xây dựng. Với nền tảng phát triển bền vững và tuân thủ những tiêu chí trong kinh doanh, doanh nghiệp đã từng bước tạo dựng được thương hiệu. Đội ngũ VIKI luôn ý thức sứ mệnh phục vụ khách hàng và cộng đồng với phương châm <strong class="text-white font-bold">"Uy tín - Chất lượng - Sức trẻ"</strong> trong từng công trình.
                    </p>

                    <!-- Cụm xếp ảnh bất đối xứng (Collage) cố định tuyệt đối kích thước, chống nhảy layout -->
                    <div class="grid grid-cols-12 gap-3 items-stretch pt-1 about-collage-container">
                        
                        <!-- Cột trái (5 phần): Chia 2 hàng bằng nhau cho Logo và Ảnh 1 -->
                        <div class="col-span-5 grid grid-rows-2 gap-3 h-full">
                            
                            <!-- Logo cố định kích thước, không đổi -->
                            <div class="bg-white/30 rounded-xl shadow-md flex items-center justify-center flex-1 border border-white/10 min-h-[110px]">
                                <img src="/logoViki.png" alt="VIKI Logo" class="w-auto max-h-[110px] object-contain">
                            </div>

                            <!-- Ảnh 1: Khóa cứng khung bằng relative kết hợp absolute inset-0 -->
                            <div class="relative rounded-xl overflow-hidden shadow-lg w-full h-full min-h-[160px] lg:min-h-0">
                                <img id="collage-img-1" src="/img/veChungToi001.png" alt="Thi công VIKI" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out">
                            </div>

                        </div>

                        <!-- Cột phải (7 phần): Ảnh lớn cố định khung tuyệt đối -->
                        <div class="col-span-7 relative rounded-xl overflow-hidden shadow-lg h-full min-h-[330px] lg:min-h-0">
                            <img id="collage-img-2" src="/img/veChungToi002.png" alt="Kỹ sư VIKI" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out">
                        </div>

                    </div>
                </div>

                <!-- CỘT PHẢI: Bảng số liệu thống kê chuẩn từng màu chữ & kích thước -->
                <div class="lg:col-span-6 space-y-0 pt-2">
                    
                    <!-- Dòng 1: Thành lập -->
                    <div class="py-5 border-t border-b border-white/15 flex items-center justify-between gap-4">
                        <span class="text-white text-base md:text-[16px] font-semibold leading-tight">Thành lập<br><span class="text-slate-200 text-base md:text-[16px] font-normal">(từ 2020)</span></span>
                        <div class="flex items-baseline text-red-600">
                            <span class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight" id="counter-years">6</span>
                            <span class="text-2xl sm:text-3xl font-extrabold ml-2">năm</span>
                        </div>
                    </div>

                    <!-- Dòng 2: Dự án -->
                    <div class="py-5 border-b border-white/15 flex items-center justify-between gap-4">
                        <span class="text-white text-base md:text-[16px] font-semibold">Dự án</span>
                        <div class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-[#40C08D] tracking-tight" data-target="15" id="counter-projects">
                            0
                        </div>
                    </div>

                    <!-- Dòng 3: Đơn vị / Chủ đầu tư đối tác -->
                    <div class="py-5 border-b border-white/15 flex items-center justify-between gap-4">
                        <span class="text-white text-base md:text-[16px] font-semibold leading-tight">Đơn vị/Chủ đầu tư đối tác<br><span class="text-slate-200 text-xs font-normal">CP Group, GREENFEED, AAC, KSP,...</span></span>
                        <div class="flex items-baseline text-[#38B6FF]">
                            <span class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight" data-target="15" id="counter-partners">0</span>
                        </div>
                    </div>

                    <!-- Dòng 4: Kỹ sư & Nhân sự -->
                    <div class="py-5 border-b border-white/15 flex items-center justify-between gap-4">
                        <span class="text-white text-base md:text-[16px] font-semibold">Kỹ sư & Nhân sự</span>
                        <div class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-[#FFC72C] tracking-tight" data-target="100" id="counter-staff">
                            0
                        </div>
                    </div>

                    <!-- Dòng 5: Tỉnh / thành phố đã thi công -->
                    <div class="py-5 border-b border-white/15 flex items-center justify-between gap-4">
                        <span class="text-white text-base md:text-[16px] font-semibold leading-tight">Tỉnh/thành phố đã thi công<br><span class="text-slate-200 text-xs font-normal">TP.HCM, Bình Dương, Bình Phước,...</span></span>
                        <div class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-[#FFC72C] tracking-tight" data-target="10" id="counter-provinces">
                            0
                        </div>
                    </div>

                </div>

            </div>

            <!-- Cụm Text Watermark chìm ở góc dưới -->
            <div class="mt-12 opacity-[0.06] select-none pointer-events-none text-right space-y-1">
                <div class="text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-widest text-white">KIẾN TẠO TƯƠNG LAI</div>
                <div class="text-3xl sm:text-5xl md:text-6xl font-black uppercase tracking-wider text-white">BUILDING FUTURES</div>
            </div>

        </div>
    </section>

    <!-- CHÚNG TÔI LÀM GÌ SECTION -->
    <section class="py-20 bg-white border-b border-[#E6EAF2]" id="whatWeDo">
        <div class="container mx-auto px-4">
            <!-- Tiêu đề tổng phần -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-14 pb-4 border-b-2 border-[#16315E] gap-4">
                <div class="flex items-center gap-3">
                    <img src="/icon-hamburger-blue.png" alt="Icon" class="w-8 h-8 object-contain">
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide">
                        CHÚNG TÔI LÀM GÌ?
                    </h2>
                </div>
                <a href="/whatWeDo" class="inline-flex items-center gap-2 bg-[#264ABC] hover:bg-[#16315E] text-white px-5 py-3 text-sm font-bold uppercase tracking-wider transition shadow-md no-underline">
                    <span>Tìm hiểu dịch vụ</span> 
                    <svg class="w-4 h-4 text-[#5FD1C1]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                </a>
            </div>

            <!-- 4 Cards Grid -->
            <div class="wwd-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
                
                <!-- CARD 1 -->
                <div class="wwd-card relative group overflow-hidden rounded-xl min-h-[440px] p-6 flex flex-col justify-end shadow-lg transition-all duration-300" style="background-image: linear-gradient(to top, rgba(22, 49, 94, 0.95) 30%, rgba(22, 49, 94, 0.3) 80%, transparent 100%), url('/img/chungToiLamGiHome001.png'); background-size: cover; background-position: center;">
                    <div class="relative z-10 flex flex-col justify-end h-full wwd-card-content-box">
                        <div class="flex items-center justify-between gap-3 cursor-pointer wwd-mobile-toggle">
                            <h3 class="text-xl font-bold text-white uppercase tracking-wide leading-snug m-0 pr-2">
                                Xây dựng Dân dụng
                            </h3>
                            <span class="text-white text-sm font-semibold flex items-center gap-1.5 lg:hidden wwd-toggle-text whitespace-nowrap shrink-0">
                                Xem thêm <span class="w-6 h-6 flex items-center justify-center bg-white/20 rounded text-base font-bold transition-transform duration-300">+</span>
                            </span>
                            <svg class="wwd-arrow w-10 h-10 text-white shrink-0 hidden lg:block" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                        </div>
                        <div class="wwd-card-desc-wrapper">
                            <p class="wwd-card-desc text-sm text-slate-200 leading-relaxed font-normal mt-3 line-clamp-3">
                                VIKI cung cấp giải pháp thi công toàn diện, đảm bảo tiêu chuẩn kỹ thuật, chất lượng và tiến độ cho các công trình dân dụng và nhà xưởng công nghiệp.
                            </p>
                            <!-- Thêm lg:hidden ở đây để ẩn trên PC -->
                            <a href="/whatWeDo/dan-dung" class="lg:hidden inline-flex items-center gap-2 text-white text-sm font-bold uppercase tracking-wider mt-4 no-underline hover:underline">
                                <span>XEM CHI TIẾT</span>
                                <svg class="w-4 h-4 text-[#5FD1C1]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- CARD 2 -->
                <div class="wwd-card relative group overflow-hidden rounded-xl min-h-[440px] p-6 flex flex-col justify-end shadow-lg transition-all duration-300" style="background-image: linear-gradient(to top, rgba(22, 49, 94, 0.95) 30%, rgba(22, 49, 94, 0.3) 80%, transparent 100%), url('/img/chungToiLamGiHome002.png'); background-size: cover; background-position: center;">
                    <div class="relative z-10 flex flex-col justify-end h-full wwd-card-content-box">
                        <div class="flex items-center justify-between gap-3 cursor-pointer wwd-mobile-toggle">
                            <h3 class="text-xl font-bold text-white uppercase tracking-wide leading-snug m-0 pr-2">
                                Mảng Công nghiệp
                            </h3>
                            <span class="text-white text-sm font-semibold flex items-center gap-1.5 lg:hidden wwd-toggle-text whitespace-nowrap shrink-0">
                                Xem thêm <span class="w-6 h-6 flex items-center justify-center bg-white/20 rounded text-base font-bold transition-transform duration-300">+</span>
                            </span>
                            <svg class="wwd-arrow w-10 h-10 text-white shrink-0 hidden lg:block" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                        </div>
                        <div class="wwd-card-desc-wrapper">
                            <p class="wwd-card-desc text-sm text-slate-200 leading-relaxed font-normal mt-3 line-clamp-3">
                                Triển khai xây dựng và mở rộng các nhà máy sản xuất, kho bãi quy mô lớn tại các khu công nghiệp trọng điểm trên cả nước.
                            </p>
                            <!-- Thêm lg:hidden ở đây để ẩn trên PC -->
                            <a href="/whatWeDo/cong-nghiep" class="lg:hidden inline-flex items-center gap-2 text-white text-sm font-bold uppercase tracking-wider mt-4 no-underline hover:underline">
                                <span>XEM CHI TIẾT</span>
                                <svg class="w-4 h-4 text-[#5FD1C1]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- CARD 3 -->
                <div class="wwd-card relative group overflow-hidden rounded-xl min-h-[440px] p-6 flex flex-col justify-end shadow-lg transition-all duration-300" style="background-image: linear-gradient(to top, rgba(22, 49, 94, 0.95) 30%, rgba(22, 49, 94, 0.3) 80%, transparent 100%), url('/img/chungToiLamGiHome003.png'); background-size: cover; background-position: center;">
                    <div class="relative z-10 flex flex-col justify-end h-full wwd-card-content-box">
                        <div class="flex items-center justify-between gap-3 cursor-pointer wwd-mobile-toggle">
                            <h3 class="text-xl font-bold text-white uppercase tracking-wide leading-snug m-0 pr-2">
                                Mảng Chăn nuôi
                            </h3>
                            <span class="text-white text-sm font-semibold flex items-center gap-1.5 lg:hidden wwd-toggle-text whitespace-nowrap shrink-0">
                                Xem thêm <span class="w-6 h-6 flex items-center justify-center bg-white/20 rounded text-base font-bold transition-transform duration-300">+</span>
                            </span>
