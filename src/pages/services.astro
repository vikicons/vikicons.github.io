---
import Layout from '../layouts/layout.astro';
---

<Layout title="Lĩnh Vực Hoạt Động | VIKI Construction Corporation">

    <!-- HERO BANNER & SUB-NAVIGATION -->
    <section class="bg-[#16315E] text-white pt-12 pb-16 relative overflow-hidden border-b-4 border-[#FFC709]">
        <div class="container mx-auto px-4 relative z-10">
            
            <!-- Sub Navigation Bar -->
            <div class="flex flex-wrap items-center justify-between gap-4 mb-12 pb-4 border-b border-white/15 text-xs sm:text-sm">
                <div class="flex items-center gap-2 sm:gap-6 font-semibold uppercase tracking-wider overflow-x-auto">
                    <a href="#overview" class="text-white hover:text-[#5FD1C1] transition no-underline whitespace-nowrap">Lĩnh vực hoạt động</a>
                    <span class="text-white/30">|</span>
                    <a href="#business-sectors" class="text-white/80 hover:text-[#5FD1C1] transition no-underline whitespace-nowrap">Ngành nghề kinh doanh</a>
                    <span class="text-white/30">|</span>
                    <a href="#safety-quality" class="text-white/80 hover:text-[#5FD1C1] transition no-underline whitespace-nowrap">An toàn & Chất lượng</a>
                    <span class="text-white/30">|</span>
                    <a href="#equipment" class="text-white/80 hover:text-[#5FD1C1] transition no-underline whitespace-nowrap">Thiết bị thi công</a>
                </div>
                <a href="/profile-viki.pdf" target="_blank" class="hidden md:inline-flex items-center gap-2 bg-[#264ABC] hover:bg-[#214080] text-white px-4 py-2 text-xs font-bold uppercase tracking-wider transition no-underline border border-white/20">
                    <span>HỒ SƠ NĂNG LỰC 2026</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </a>
            </div>

            <!-- Hero Main Headline -->
            <div class="max-w-4xl">
                <div class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#5FD1C1] mb-3">VIKI BUSINESS SECTORS</div>
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold uppercase tracking-tight leading-none mb-6">
                    LĨNH VỰC HOẠT ĐỘNG <br />
                    <span class="text-[#38B6FF]">Chuyên Nghiệp & Bền Vững</span>
                </h1>
                <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-light text-justify max-w-3xl">
                    Công ty Cổ phần Xây dựng VIKI cung cấp các giải pháp toàn diện trong lĩnh vực xây dựng dân dụng, công nghiệp, tư vấn thiết kế và phát triển trang trại chăn nuôi công nghệ cao.
                </p>
            </div>

        </div>
    </section>

    <!-- SECTION 1: GIỚI THIỆU CHUNG & LĨNH VỰC CỐT LÕI -->
    <section class="py-20 bg-white border-b border-[#E6EAF2]" id="overview">
        <div class="container mx-auto px-4">
            
            <div class="flex items-center gap-3 mb-12 pb-4 border-b-2 border-[#16315E]">
                <div class="w-8 h-8 bg-[#214080] flex items-center justify-center text-white font-bold">V</div>
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide">
                    CHÚNG TÔI LÀM GÌ
                </h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                <div class="lg:col-span-7 space-y-4 text-[#5A6E85] text-sm sm:text-base leading-relaxed text-justify">
                    <p class="text-lg font-semibold text-[#16315E] border-l-4 border-[#ED2424] pl-4 py-1">
                        Khởi nguồn cho những hành trình mới với chất lượng thi công đạt chuẩn quốc tế.
                    </p>
                    <p>
                        VIKI hoạt động mạnh mẽ trong các lĩnh vực trọng điểm bao gồm xây dựng nhà xưởng công nghiệp quy mô lớn, hạ tầng khu chế xuất, các công trình dân dụng kỹ thuật cao và hệ thống trang trại chăn nuôi khép kín tiêu chuẩn hiện đại.
                    </p>
                    <p>
                        Với đội ngũ kỹ sư giàu kinh nghiệm và hệ thống máy móc thiết bị đồng bộ, chúng tôi cam kết mang lại sự tối ưu tuyệt đối về tiến độ, chất lượng và chi phí cho mọi chủ đầu tư trong và ngoài nước.
                    </p>
                </div>
                <div class="lg:col-span-5">
                    <div class="relative rounded-xl overflow-hidden shadow-xl border-4 border-[#F4F6FA]">
                        <img src="/img/doiNguVikiHome001.png" alt="Đội ngũ kỹ sư VIKI" class="w-full h-[320px] object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-[#16315E]/80 via-transparent to-transparent flex flex-col justify-end p-6 text-white">
                            <h3 class="text-lg font-bold uppercase m-0">NĂNG LỰC THỰC THI THỰC TẾ</h3>
                            <p class="text-xs text-[#5FD1C1] m-0">Đội ngũ kỹ sư trực tiếp khảo sát và thi công công trình</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- SECTION 2: NGÀNH NGHỀ KINH DOANH & LĨNH VỰC HOẠT ĐỘNG (Dựa trên trang 06-07 PDF) -->
    <section class="py-20 bg-[#FAF9F9] border-b border-[#E6EAF2]" id="business-sectors">
        <div class="container mx-auto px-4">
            
            <div class="flex items-center gap-3 mb-12 pb-4 border-b-2 border-[#16315E]">
                <div class="w-8 h-8 bg-[#214080] flex items-center justify-center text-white font-bold">V</div>
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide">
                    NGÀNH NGHỀ KINH DOANH & LĨNH VỰC HOẠT ĐỘNG
                </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <!-- Card 1: Xây dựng dân dụng và công nghiệp -->
                <div class="bg-white border border-[#E6EAF2] shadow-sm hover:shadow-md transition flex flex-col overflow-hidden">
                    <div class="h-48 overflow-hidden bg-slate-200">
                        <img src="/img/chungToiLamGiHome001.webp" alt="Xây dựng dân dụng và công nghiệp" class="w-full h-full object-cover hover:scale-105 transition duration-500">
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="text-xs font-bold text-[#ED2424] uppercase mb-1">MẢNG CÔNG NGHIỆP</div>
                            <h3 class="text-xl font-bold uppercase text-[#16315E] mb-3">Xây Dựng Dân Dụng & Công Nghiệp</h3>
                            <p class="text-sm text-[#5A6E85] leading-relaxed text-justify mb-4">
                                Chuyên thiết kế và thi công nhà xưởng, kho bãi, nhà máy sản xuất công nghệ cao, tòa nhà văn phòng và các công trình hạ tầng kỹ thuật đạt tiêu chuẩn quốc tế.
                            </p>
                        </div>
                        <div class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-[#214080]">
                            <span>TIÊU CHUẨN ISO</span>
                            <span>VIKI CORP</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Tư vấn thiết kế xây dựng -->
                <div class="bg-white border border-[#E6EAF2] shadow-sm hover:shadow-md transition flex flex-col overflow-hidden">
                    <div class="h-48 overflow-hidden bg-slate-200">
                        <img src="/img/chungToiLamGiHome004.webp" alt="Tư vấn thiết kế xây dựng" class="w-full h-full object-cover hover:scale-105 transition duration-500">
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="text-xs font-bold text-[#38B6FF] uppercase mb-1">TƯ VẤN & THIẾT KẾ</div>
                            <h3 class="text-xl font-bold uppercase text-[#16315E] mb-3">Tư Vấn Thiết Kế Xây Dựng</h3>
                            <p class="text-sm text-[#5A6E85] leading-relaxed text-justify mb-4">
                                Cung cấp giải pháp tư vấn lập dự án đầu tư, thiết kế kiến trúc, kết cấu và hệ thống cơ điện (MEP) tối ưu hóa chi phí và công năng vận hành cho doanh nghiệp.
                            </p>
                        </div>
                        <div class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-[#214080]">
                            <span>TỐI ƯU CHI PHÍ</span>
                            <span>VIKI CORP</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Trang trại chăn nuôi VIKI -->
                <div class="bg-white border border-[#E6EAF2] shadow-sm hover:shadow-md transition flex flex-col overflow-hidden">
                    <div class="h-48 overflow-hidden bg-slate-200">
                        <img src="/img/duAnBieuTuongHome003.webp" alt="Trang trại chăn nuôi VIKI" class="w-full h-full object-cover hover:scale-105 transition duration-500">
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="text-xs font-bold text-[#40C08D] uppercase mb-1">MẢNG CHĂN NUÔI</div>
                            <h3 class="text-xl font-bold uppercase text-[#16315E] mb-3">Trang Trại Chăn Nuôi VIKI</h3>
                            <p class="text-sm text-[#5A6E85] leading-relaxed text-justify mb-4">
                                Đầu tư và thi công các dự án trang trại chăn nuôi quy mô lớn, góp phần thúc đẩy tiến trình công nghiệp hóa trong nông nghiệp và phát triển kinh tế địa phương.
                            </p>
                        </div>
                        <div class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-[#214080]">
                            <span>KINH TẾ TRANG TRẠI</span>
                            <span>VIKI CORP</span>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- SECTION 3: ĐỊNH HƯỚNG PHÁT TRIỂN & CAM KẾT DỊCH VỤ -->
    <section class="py-20 bg-white border-b border-[#E6EAF2]" id="development-orientation">
        <div class="container mx-auto px-4">
            
            <div class="flex items-center gap-3 mb-12 pb-4 border-b-2 border-[#16315E]">
                <div class="w-8 h-8 bg-[#214080] flex items-center justify-center text-white font-bold">V</div>
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide">
                    ĐỊNH HƯỚNG PHÁT TRIỂN DỊCH VỤ
                </h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                
                <div class="p-6 bg-[#FAF9F9] border-t-4 border-[#214080] shadow-sm">
                    <div class="text-3xl font-black text-[#214080] mb-3">1</div>
                    <h3 class="text-lg font-bold uppercase text-[#16315E] mb-2">GIẢI PHÁP TOÀN DIỆN</h3>
                    <p class="text-xs text-[#5A6E85] leading-relaxed text-justify m-0">
                        Cung cấp dịch vụ trọn gói từ khâu lập dự án, xin phép, thiết kế đến thi công hoàn thiện bàn giao đưa vào sử dụng.
                    </p>
                </div>

                <div class="p-6 bg-[#FAF9F9] border-t-4 border-[#264ABC] shadow-sm">
                    <div class="text-3xl font-black text-[#264ABC] mb-3">2</div>
                    <h3 class="text-lg font-bold uppercase text-[#16315E] mb-2">ĐA DẠNG HỆ SINH THÁI</h3>
                    <p class="text-xs text-[#5A6E85] leading-relaxed text-justify m-0">
                        Mở rộng danh mục dịch vụ phục vụ đa ngành từ nhà xưởng công nghiệp nhẹ đến các tổ hợp kho vận và trang trại lớn.
                    </p>
                </div>

                <div class="p-6 bg-[#FAF9F9] border-t-4 border-[#38B6FF] shadow-sm">
                    <div class="text-3xl font-black text-[#38B6FF] mb-3">3</div>
                    <h3 class="text-lg font-bold uppercase text-[#16315E] mb-2">ĐỀ CAO SỰ HÀI LÒNG</h3>
                    <p class="text-xs text-[#5A6E85] leading-relaxed text-justify m-0">
                        Lấy sự hài lòng và tín nhiệm của khách hàng làm thước đo cao nhất cho mọi thành công của tập thể VIKI.
                    </p>
                </div>

                <div class="p-6 bg-[#FAF9F9] border-t-4 border-[#ED2424] shadow-sm">
                    <div class="text-3xl font-black text-[#ED2424] mb-3">4</div>
                    <h3 class="text-lg font-bold uppercase text-[#16315E] mb-2">GIÁ TRỊ GIA TĂNG</h3>
                    <p class="text-xs text-[#5A6E85] leading-relaxed text-justify m-0">
                        Không ngừng gia tăng các giá trị về mỹ thuật, độ bền và tính kinh tế vượt trội cho từng công trình dự án.
                    </p>
                </div>

            </div>

        </div>
    </section>

    <!-- SECTION 4: AN TOÀN & CHẤT LƯỢNG THI CÔNG -->
    <section class="py-20 bg-[#16315E] text-white border-b border-[#E6EAF2]" id="safety-quality">
        <div class="container mx-auto px-4">
            
            <div class="flex items-center gap-3 mb-8 pb-4 border-b border-white/20">
                <div class="w-8 h-8 bg-[#38B6FF] flex items-center justify-center text-white font-bold">V</div>
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white m-0 uppercase tracking-wide">
                    AN TOÀN & CHẤT LƯỢNG
                </h2>
            </div>

            <p class="text-slate-200 text-sm sm:text-base max-w-3xl mb-12 leading-relaxed text-justify">
                Tại VIKI, an toàn và chất lượng là hai yếu tố hàng đầu không thể thỏa hiệp. Chúng tôi áp dụng nghiêm ngặt các quy trình kiểm định an toàn lao động và tiêu chuẩn kỹ thuật xây dựng tiên tiến nhất vào từng hạng mục thi công thực tế.
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
                <div class="rounded-lg overflow-hidden shadow-lg border border-white/15 h-48 bg-slate-800">
                    <img src="/img/anToanChatLuong001.png" alt="Thi công an toàn VIKI" class="w-full h-full object-cover hover:scale-105 transition duration-300">
                </div>
                <div class="rounded-lg overflow-hidden shadow-lg border border-white/15 h-48 bg-slate-800">
                    <img src="/img/anToanChatLuong002.png" alt="Kiểm tra kỹ thuật công trình" class="w-full h-full object-cover hover:scale-105 transition duration-300">
                </div>
                <div class="rounded-lg overflow-hidden shadow-lg border border-white/15 h-48 bg-slate-800">
                    <img src="/img/anToanChatLuong003.png" alt="Kỹ sư giám sát thi công" class="w-full h-full object-cover hover:scale-105 transition duration-300">
                </div>
                <div class="rounded-lg overflow-hidden shadow-lg border border-white/15 h-48 bg-slate-800">
                    <img src="/img/anToanChatLuong004.png" alt="Dự án hoàn thành VIKI" class="w-full h-full object-cover hover:scale-105 transition duration-300">
                </div>
                <div class="rounded-lg overflow-hidden shadow-lg border border-white/15 h-48 bg-slate-800 hidden sm:block">
                    <img src="/img/nhaMayKspHaiDuong001.png" alt="Hạ tầng khu công nghiệp" class="w-full h-full object-cover hover:scale-105 transition duration-300">
                </div>
            </div>

        </div>
    </section>

    <!-- SECTION 5: THIẾT BỊ THI CÔNG (Trang 10 tài liệu PDF) -->
    <section class="py-20 bg-white" id="equipment">
        <div class="container mx-auto px-4">
            
            <div class="flex items-center gap-3 mb-8 pb-4 border-b-2 border-[#16315E]">
                <div class="w-8 h-8 bg-[#214080] flex items-center justify-center text-white font-bold">V</div>
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide">
                    THIẾT BỊ THI CÔNG
                </h2>
            </div>

            <p class="text-[#5A6E85] text-sm sm:text-base max-w-3xl mb-12 leading-relaxed text-justify">
                Với hệ thống thiết bị thi công hiện đại, đồng bộ và luôn được bảo dưỡng định kỳ, VIKI tự chủ hoàn toàn tiến độ triển khai các dự án quy mô lớn trên toàn quốc.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <div class="bg-[#FAF9F9] border border-[#E6EAF2] rounded-lg overflow-hidden shadow-sm">
                    <div class="h-56 bg-slate-100 overflow-hidden">
                        <img src="/img/thietBiThiCong001.png" alt="Cẩu tháp thi công" class="w-full h-full object-cover hover:scale-105 transition duration-300">
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-bold uppercase text-[#16315E] mb-2">Hệ Thống Cẩu Tháp</h3>
                        <p class="text-xs text-[#5A6E85] leading-relaxed m-0">
                            Trang bị các dòng cẩu tháp công suất lớn đáp ứng hoạt động nâng hạ vật liệu xây dựng ở độ cao phức tạp.
                        </p>
                    </div>
                </div>

                <div class="bg-[#FAF9F9] border border-[#E6EAF2] rounded-lg overflow-hidden shadow-sm">
                    <div class="h-56 bg-slate-100 overflow-hidden">
                        <img src="/img/thietBiThiCong002.png" alt="Cẩu tháp Poma MR 438" class="w-full h-full object-cover hover:scale-105 transition duration-300">
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-bold uppercase text-[#16315E] mb-2">Cẩu Tháp Poma MR 438 (24T)</h3>
                        <p class="text-xs text-[#5A6E85] leading-relaxed m-0">
                            Thiết bị chuyên dụng tải trọng cao, vận hành ổn định trong các điều kiện thi công công nghiệp nặng.
                        </p>
                    </div>
                </div>

                <div class="bg-white border border-[#E6EAF2] rounded-lg overflow-hidden shadow-sm">
                    <div class="h-56 bg-slate-100 overflow-hidden">
                        <img src="/img/thietBiThiCong003.png" alt="Vận thăng HOIST" class="w-full h-full object-cover hover:scale-105 transition duration-300">
                    </div>
                    <div class="p-6">
                        <h3 class="text-lg font-bold uppercase text-[#16315E] mb-2">Vận Thăng (HOIST)</h3>
                        <p class="text-xs text-[#5A6E85] leading-relaxed m-0">
                            Hệ thống vận thăng chở vật tư và nhân sự an toàn, linh hoạt trên các tầng cao của công trình.
                        </p>
                    </div>
                </div>

            </div>

        </div>
    </section>

</Layout>