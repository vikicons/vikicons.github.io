---
import Layout from '../layouts/layout.astro';
---

<Layout title="Liên Hệ | VIKI Construction Corporation">

    <div class="bg-white min-h-screen py-12 text-[#16315E]">
        <div class="container mx-auto px-4 max-w-7xl">
            
            <!-- HERO / HEADER SECTION -->
            <div class="mb-12 border-b border-gray-200 pb-8">
                <div class="text-xs sm:text-sm font-bold uppercase tracking-[0.2em] text-[#5FD1C1] mb-1">BUILDING FUTURES</div>
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                    <div>
                        <h1 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight text-[#16315E] m-0">
                            LIÊN HỆ
                        </h1>
                    </div>
                    <p class="text-xs sm:text-sm text-[#5A6E85] max-w-md m-0 text-left md:text-right">
                        Để đảm bảo yêu cầu của bạn được gửi đến đúng bộ phận tiếp nhận, vui lòng chọn mục đích liên hệ dưới đây.
                    </p>
                </div>
            </div>

            <!-- SECTION: CHỌN MỤC ĐÍCH LIÊN HỆ -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-10 gap-x-12 mb-20">
                
                <!-- Item 1 -->
                <div class="space-y-3 pt-4 border-t border-gray-200 group cursor-pointer">
                    <div class="w-10 h-10 text-[#5FD1C1] flex items-center">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                    </div>
                    <h3 class="text-base font-bold uppercase text-[#16315E] group-hover:text-[#38B6FF] transition m-0">Hỏi đáp chung</h3>
                </div>

                <!-- Item 2 -->
                <div class="space-y-3 pt-4 border-t border-gray-200 group cursor-pointer">
                    <div class="w-10 h-10 text-[#5FD1C1] flex items-center">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    </div>
                    <h3 class="text-base font-bold uppercase text-[#16315E] group-hover:text-[#38B6FF] transition m-0">Báo chí & Truyền thông</h3>
                </div>

                <!-- Item 3 -->
                <div class="space-y-3 pt-4 border-t border-gray-200 group cursor-pointer">
                    <div class="w-10 h-10 text-[#5FD1C1] flex items-center">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    </div>
                    <h3 class="text-base font-bold uppercase text-[#16315E] group-hover:text-[#38B6FF] transition m-0">Tuyển dụng</h3>
                </div>

                <!-- Item 4 -->
                <div class="space-y-3 pt-4 border-t border-gray-200 group cursor-pointer">
                    <div class="w-10 h-10 text-[#5FD1C1] flex items-center">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                    </div>
                    <h3 class="text-base font-bold uppercase text-[#16315E] group-hover:text-[#38B6FF] transition m-0">Kỹ thuật và Tuân thủ</h3>
                </div>

                <!-- Item 5 -->
                <div class="space-y-3 pt-4 border-t border-gray-200 group cursor-pointer">
                    <div class="w-10 h-10 text-[#5FD1C1] flex items-center">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                    </div>
                    <h3 class="text-base font-bold uppercase text-[#16315E] group-hover:text-[#38B6FF] transition m-0">Nguyên vật liệu</h3>
                </div>

                <!-- Item 6 -->
                <div class="space-y-3 pt-4 border-t border-gray-200 group cursor-pointer">
                    <div class="w-10 h-10 text-[#5FD1C1] flex items-center">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    </div>
                    <h3 class="text-base font-bold uppercase text-[#16315E] group-hover:text-[#38B6FF] transition m-0">Nhân lực</h3>
                </div>

                <!-- Item 7 -->
                <div class="space-y-3 pt-4 border-t border-gray-200 group cursor-pointer">
                    <div class="w-10 h-10 text-[#5FD1C1] flex items-center">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                    <h3 class="text-base font-bold uppercase text-[#16315E] group-hover:text-[#38B6FF] transition m-0">Thiết bị</h3>
                </div>

            </div>

            <!-- SECTION: CHÚNG TÔI Ở ĐÂY -->
            <div class="pt-10 border-t-2 border-[#16315E]">
                
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-12">
                    <h2 class="text-2xl sm:text-4xl font-extrabold uppercase text-[#16315E] m-0 tracking-wide">
                        CHÚNG TÔI Ở ĐÂY
                    </h2>
                    <div class="flex items-center gap-4">
                        <span class="text-xs font-bold uppercase tracking-wider text-[#5A6E85]">Contact with VIKI on socials</span>
                        <div class="flex items-center gap-3">
                            <a href="#" class="w-8 h-8 bg-black text-white rounded flex items-center justify-center hover:bg-[#214080] transition"><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
                            <a href="#" class="w-8 h-8 bg-black text-white rounded flex items-center justify-center hover:bg-[#214080] transition"><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
                            <a href="#" class="w-8 h-8 bg-black text-white rounded flex items-center justify-center hover:bg-[#214080] transition"><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg></a>
                            <a href="#" class="w-8 h-8 bg-black text-white rounded flex items-center justify-center hover:bg-[#214080] transition"><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm4.441 16.892c-2.102.144-4.008-.824-4.996-2.612-.39-.706-.596-1.48-.616-2.264-.02-1.036.324-2.032.97-2.812.836-.996 2.064-1.588 3.39-1.636 1.442-.054 2.802.464 3.824 1.442l-1.32 1.32c-.636-.616-1.472-.94-2.352-.904-.848.032-1.636.42-2.164 1.076-.528.656-.76 1.504-.64 2.368.108.77.484 1.48 1.048 2.012.636.596 1.472.916 2.352.884.716-.028 1.412-.284 1.996-.732l.84 1.2c-.816.636-1.824.996-2.868 1.036z"/></svg></a>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    
                    <!-- Trụ sở chính -->
                    <div class="space-y-3 pt-4 border-t border-gray-200">
                        <div class="text-[#5FD1C1]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                        </div>
                        <h3 class="text-sm font-bold uppercase text-[#16315E]">Thành phố Hồ Chí Minh - Trụ sở chính</h3>
                        <p class="text-xs text-[#5A6E85] leading-relaxed m-0">
                            Tòa nhà VIKI, 236/6 Điện Biên Phủ, Phường Gia Định, Thành phố Hồ Chí Minh
                        </p>
                        <p class="text-xs text-[#5A6E85] m-0 font-medium">Tel: 84.28-35142255/66</p>
                        <p class="text-xs text-[#5A6E85] m-0 font-medium">Email: contact@viki.com.vn</p>
                    </div>

                    <!-- Văn phòng đại diện Hà Nội -->
                    <div class="space-y-3 pt-4 border-t border-gray-200">
                        <div class="text-[#5FD1C1]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                        </div>
                        <h3 class="text-sm font-bold uppercase text-[#16315E]">Hà Nội - Văn phòng đại diện</h3>
                        <p class="text-xs text-[#5A6E85] leading-relaxed m-0">
                            Tầng 8 - Tháp 2 - Tòa Capital Place - Số 29 Liễu Giai, Phường Ngọc Hà, Thành phố Hà Nội
                        </p>
                        <p class="text-xs text-[#5A6E85] m-0 font-medium">Tel: 84.24-73016216</p>
                        <p class="text-xs text-[#5A6E85] m-0 font-medium">Email: contacthn@viki.com.vn</p>
                    </div>

                    <!-- Kênh tiếp nhận thông tin về Tuân thủ -->
                    <div class="space-y-3 pt-4 border-t border-gray-200">
                        <div class="text-[#5FD1C1]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                        </div>
                        <h3 class="text-sm font-bold uppercase text-[#16315E]">Kênh tiếp nhận thông tin về Tuân Thủ</h3>
                        <p class="text-xs text-[#5A6E85] leading-relaxed m-0">
                            Tiếp nhận và giải đáp các vấn đề liên quan đến quy chuẩn, quy định tuân thủ trong hoạt động xây dựng và doanh nghiệp.
                        </p>
                        <p class="text-xs text-[#5A6E85] m-0 font-medium">Tel: 84.28-35142277</p>
                        <p class="text-xs text-[#5A6E85] m-0 font-medium">Email: Baocaotuanthu@viki.com.vn</p>
                    </div>

                </div>

            </div>

        </div>
    </div>

</Layout>