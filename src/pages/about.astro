---
import Layout from '../layouts/layout.astro';
---

<Layout title="Về Chúng Tôi | VIKI Construction Corporation">

    <!-- HERO BANNER -->
    <section class="bg-[#16315E] text-white pt-12 pb-16 relative overflow-hidden border-b-4 border-[#FFC709] w-full max-w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-28 lg:px-8 relative z-10 w-full">
            
            <!-- Hero Main Headline kết hợp nút Hồ Sơ Năng Lực 2026 bên phải -->
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8 w-full max-w-full">
                
                <!-- Phần tiêu đề và mô tả bên trái -->
                <div class="max-w-4xl w-full">
                    <div class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#5FD1C1] mb-3">BUILDING FUTURES</div>
                    <h1 class="text-3xl sm:text-5xl lg:text-[59px] font-extrabold uppercase tracking-tight leading-[1.15] mb-6 break-words">
                        <span class="block mb-2">Chúng tôi là VIKI</span>
                        <span class="text-[#38B6FF] block">Xây Giá Trị – Dựng Niềm Tin</span>
                    </h1>
                    <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-light text-justify max-w-3xl">
                        Công ty Cổ phần Xây dựng VIKI chính thức thành lập vào ngày 01 tháng 6 năm 2020. Dù ra đời trong bối cảnh thị trường nhiều thách thức, VIKI đã chọn con đường phát triển lấy uy tín và chất lượng làm nền tảng hàng đầu, không ngừng vươn mình trở thành đối tác tin cậy của các tập đoàn đa quốc gia.
                    </p>
                </div>

            </div>

        </div>
    </section>

    <!-- SECTION 3: SƠ ĐỒ NHÂN SỰ & TỔ CHỨC -->
    <section class="py-12 sm:py-16 bg-white border-b border-[#E6EAF2] viki-org-chart w-full max-w-full overflow-hidden">
        <div class="container mx-auto px-4 w-full max-w-full">

            <!-- Section Header -->
            <div class="flex items-center gap-3 mb-12 pb-4 border-b-2 border-[#16315E]">
                <img src="/icon-hamburger-blue.png" alt="Icon" class="w-8 h-8 object-contain">
                <h2 class="text-xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide break-words">
                    SƠ ĐỒ NHÂN SỰ &amp; TỔ CHỨC
                </h2>
            </div>

            <p class="text-sm sm:text-base text-[#5A6E85] max-w-3xl mb-12 leading-relaxed">
                Cơ cấu tổ chức của VIKI được xây dựng theo mô hình quản trị doanh nghiệp hiện đại, tinh gọn và chuyên môn hóa cao, đảm bảo sự phối hợp nhịp nhàng giữa các khối văn phòng và ban quản lý dự án công trường.
            </p>

            <!-- ================= KHU VỰC HIỂN THỊ TRÊN DESKTOP RỘNG (Màn hình từ 1280px trở lên) ================= -->
            <div class="hidden xl:block overflow-x-auto pb-8 pt-2 px-2 scrollbar-thin w-full max-w-full">
                <div class="min-w-[1100px] flex flex-col items-center">

                    <!-- TẦNG 1: HỘI ĐỒNG CỔ ĐÔNG -->
                    <div class="flex flex-col items-center">
                        <div class="bg-white border-2 border-[#214080] rounded-lg overflow-hidden shadow-xl w-[253px] text-center relative group transition-all duration-300 flex flex-col">
                            <div class="w-[253px] h-[285px] bg-slate-100 overflow-hidden">
                                <img src="/img/anhSoDoNhanSu001.webp" alt="Hội đồng cổ đông" class="w-full h-full object-cover" onerror="this.src='/img/anhErrorSoDoNhanSuHDCD.webp'">
                            </div>
                            <div class="bg-[#214080] text-white h-16 px-2 flex flex-col justify-center">
                                <div class="text-sm font-extrabold uppercase mt-1">HỘI ĐỒNG CỔ ĐÔNG</div>
                            </div>
                        </div>
                    </div>

                    <!-- DẤU NỐI SVG TỪ HỘI ĐỒNG CỔ ĐÔNG XUỐNG CHỦ TỊCH -->
                    <div class="w-full h-6 relative">
                        <svg class="w-full h-full overflow-visible" xmlns="http://www.w3.org/2000/svg">
                            <line x1="50%" y1="0" x2="50%" y2="100%" stroke="#214080" stroke-width="2" />
                        </svg>
                    </div>

                    <!-- TẦNG 2: CHỦ TỊCH HĐQT -->
                    <div class="flex flex-col items-center">
                        <div class="bg-white border-2 border-[#214080] rounded-lg overflow-hidden shadow-xl w-[253px] text-center relative group transition-all duration-300 flex flex-col">
                            <div class="w-[253px] h-[285px] bg-slate-100 overflow-hidden">
                                <img src="/img/anhSoDoNhanSu002.webp" alt="Chủ tịch HĐQT Lê Mạnh Toàn" class="w-full h-full object-cover" onerror="this.src='/img/anhErrorSoDoNhanSuMen.webp'">
                            </div>
                            <div class="bg-[#214080] text-white h-16 px-2 flex flex-col justify-center">
                                <div class="text-xs font-bold uppercase tracking-wider">CHỦ TỊCH HỘI ĐỒNG QUẢN TRỊ</div>
                                <div class="text-sm font-extrabold uppercase mt-1">Ông LÊ MẠNH TOÀN</div>
                            </div>
                        </div>
                    </div>

                    <!-- DẤU NỐI SVG TỪ CHỦ TỊCH XUỐNG GIÁM ĐỐC -->
                    <div class="w-full h-6 relative">
                        <svg class="w-full h-full overflow-visible" xmlns="http://www.w3.org/2000/svg">
                            <line x1="50%" y1="0" x2="50%" y2="100%" stroke="#214080" stroke-width="2" />
                        </svg>
                    </div>

                    <!-- TẦNG 3: GIÁM ĐỐC -->
                    <div class="flex flex-col items-center w-full max-w-[1100px]">
                        <div class="bg-white border-2 border-[#214080] rounded-lg overflow-hidden shadow-xl w-[253px] text-center relative group transition-all duration-300 flex flex-col mx-auto">
                            <div class="w-[253px] h-[285px] bg-slate-100 overflow-hidden">
                                <img src="/img/anhSoDoNhanSu003.webp" alt="Giám đốc Trần Văn Quân" class="w-full h-full object-cover" onerror="this.src='/img/anhErrorSoDoNhanSuMen.webp'">
                            </div>
                            <div class="bg-[#214080] text-white h-16 px-2 flex flex-col justify-center">
                                <div class="text-xs font-bold uppercase tracking-wider">GIÁM ĐỐC</div>
                                <div class="text-sm font-extrabold uppercase mt-1">Ông TRẦN VĂN QUÂN</div>
                            </div>
                        </div>

                        <!-- DẤU NỐI SVG TỪ GIÁM ĐỐC ĐẾN 5 THẺ BÊN DƯỚI -->
                        <div class="w-full h-8 relative">
                            <svg class="w-full h-full overflow-visible" xmlns="http://www.w3.org/2000/svg">
                                <line x1="50%" y1="0" x2="50%" y2="16" stroke="#214080" stroke-width="2" />
                                <line x1="10%" y1="16" x2="90%" y2="16" stroke="#214080" stroke-width="2" />
                                <line x1="10%" y1="16" x2="10%" y2="32" stroke="#214080" stroke-width="2" />
                                <line x1="30%" y1="16" x2="30%" y2="32" stroke="#214080" stroke-width="2" />
                                <line x1="50%" y1="16" x2="50%" y2="32" stroke="#214080" stroke-width="2" />
                                <line x1="70%" y1="16" x2="70%" y2="32" stroke="#214080" stroke-width="2" />
                                <line x1="90%" y1="16" x2="90%" y2="32" stroke="#214080" stroke-width="2" />
                            </svg>
                        </div>
                    </div>

                    <!-- TẦNG 4: 5 THẺ PHÒNG BAN & BAN ĐIỀU HÀNH DỰ ÁN -->
                    <div class="grid grid-cols-5 gap-5 w-full max-w-[1100px] items-stretch">

                        <!-- Thẻ 1 -->
                        <div class="bg-white border-2 border-[#214080] rounded-lg overflow-hidden shadow-md flex flex-col text-center h-full">
                            <div class="w-full h-[253px] bg-slate-100 overflow-hidden shrink-0">
                                <img src="/img/anhSoDoNhanSu004.webp" alt="Các ban điều hành dự án" class="w-full h-full object-cover" onerror="this.src='/img/anhErrorSoDoNhanSuMen.webp'">
                            </div>
                            <div class="bg-[#214080] text-white h-28 px-2 flex flex-col justify-center shrink-0">
                                <div class="text-xs font-bold uppercase tracking-normal whitespace-nowrap leading-snug">CÁC BAN ĐIỀU HÀNH DỰ ÁN</div>
                            </div>
                        </div>

                        <!-- Thẻ 2 -->
                        <div class="bg-white border-2 border-[#214080] rounded-lg overflow-hidden shadow-md flex flex-col text-center h-full">
                            <div class="w-full h-[253px] bg-slate-100 overflow-hidden shrink-0">
                                <img src="/img/anhSoDoNhanSu005.webp" alt="Phòng Quản lý Dự án" class="w-full h-full object-cover" onerror="this.src='/img/anhErrorSoDoNhanSuMen.webp'">
                            </div>
                            <div class="bg-[#214080] text-white h-28 px-2 flex flex-col justify-center shrink-0">
                                <div class="text-xs font-bold uppercase tracking-normal whitespace-nowrap leading-snug">PHÒNG QUẢN LÝ DỰ ÁN</div>
                                <div class="text-xs font-extrabold uppercase mt-1">ÔNG NGUYỄN HUY TIỆP</div>
                            </div>
                        </div>

                        <!-- Thẻ 3 -->
                        <div class="bg-white border-2 border-[#214080] rounded-lg overflow-hidden shadow-md flex flex-col text-center h-full">
                            <div class="w-full h-[253px] bg-slate-100 overflow-hidden shrink-0">
                                <img src="/img/anhSoDoNhanSu006.webp" alt="Phòng Tổ chức - Hành chính" class="w-full h-full object-cover" onerror="this.src='/img/anhErrorSoDoNhanSuWomen.webp'">
                            </div>
                            <div class="bg-[#214080] text-white h-28 px-2 flex flex-col justify-center shrink-0">
                                <div class="text-xs font-bold uppercase tracking-normal whitespace-nowrap leading-snug">PHÒNG TỔ CHỨC - HÀNH CHÍNH</div>
                                <div class="text-xs font-extrabold uppercase mt-1">BÀ TRẦN THỊ SUM</div>
                            </div>
                        </div>

                        <!-- Thẻ 4 -->
                        <div class="bg-white border-2 border-[#214080] rounded-lg overflow-hidden shadow-md flex flex-col text-center h-full">
                            <div class="w-full h-[253px] bg-slate-100 overflow-hidden shrink-0">
                                <img src="/img/anhSoDoNhanSu007.webp" alt="Phòng Tài chính - Kế toán" class="w-full h-full object-cover" onerror="this.src='/img/anhErrorSoDoNhanSuWomen.webp'">
                            </div>
                            <div class="bg-[#214080] text-white h-28 px-2 flex flex-col justify-center shrink-0">
                                <div class="text-xs font-bold uppercase tracking-normal whitespace-nowrap leading-snug">PHÒNG TÀI CHÍNH - KẾ TOÁN</div>
                                <div class="text-xs font-extrabold uppercase mt-1">BÀ TRẦN THANH HƯƠNG</div>
                            </div>
                        </div>

                        <!-- Thẻ 5 -->
                        <div class="bg-white border-2 border-[#214080] rounded-lg overflow-hidden shadow-md flex flex-col text-center h-full">
                            <div class="w-full h-[253px] bg-slate-100 overflow-hidden shrink-0">
                                <img src="/img/anhSoDoNhanSu008.webp" alt="Phòng Vật tư - Thiết bị" class="w-full h-full object-cover" onerror="this.src='/img/anhErrorSoDoNhanSuWomen.webp'">
                            </div>
                            <div class="bg-[#214080] text-white h-28 px-2 flex flex-col justify-center shrink-0">
                                <div class="text-xs font-bold uppercase tracking-normal whitespace-nowrap leading-snug">PHÒNG VẬT TƯ - THIẾT BỊ</div>
                                <div class="text-xs font-extrabold uppercase mt-1">BÀ NGUYỄN THỊ CẨM TÚ</div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>


            <!-- ================= KHU VỰC HIỂN THỊ TRÊN MOBILE & TẤT CẢ CÁC DÒNG IPAD (Dưới 1280px) ================= -->
            <div class="block xl:hidden flex flex-col items-center w-full max-w-full overflow-hidden">
                
                <!-- 1. Hội đồng cổ đông -->
                <div class="bg-white border-2 border-[#214080] rounded-xl overflow-hidden shadow-lg text-center w-full max-w-[253px]">
                    <div class="w-full h-[285px] bg-slate-100 overflow-hidden">
                        <img src="/img/anhSoDoNhanSu001.webp" alt="Hội đồng cổ đông" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=400&q=80'">
                    </div>
                    <div class="bg-[#214080] text-white py-3 px-2">
                        <div class="text-[10px] font-bold uppercase tracking-wider">CƠ QUAN QUYẾT ĐỊNH CAO NHẤT</div>
                        <div class="text-xs font-extrabold uppercase mt-1">HỘI ĐỒNG CỔ ĐÔNG</div>
                    </div>
                </div>

                <!-- Line nối -->
                <div class="w-full h-6 relative -my-[2px] z-10">
                    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                        <line x1="50%" y1="0" x2="50%" y2="100%" stroke="#214080" stroke-width="2.5" />
                    </svg>
                </div>

                <!-- 2. Chủ tịch HĐQT -->
                <div class="bg-white border-2 border-[#214080] rounded-xl overflow-hidden shadow-lg text-center w-full max-w-[253px]">
                    <div class="w-full h-[285px] bg-slate-100 overflow-hidden">
                        <img src="/img/anhSoDoNhanSu002.webp" alt="Chủ tịch HĐQT Lê Mạnh Toàn" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&q=80'">
                    </div>
                    <div class="bg-[#214080] text-white py-3 px-2">
                        <div class="text-[10px] font-bold uppercase tracking-wider">CHỦ TỊCH HỘI ĐỒNG QUẢN TRỊ</div>
                        <div class="text-xs font-extrabold uppercase mt-1">LÊ MẠNH TOÀN</div>
                    </div>
                </div>

                <!-- Line nối -->
                <div class="w-full h-6 relative -my-[2px] z-10">
                    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                        <line x1="50%" y1="0" x2="50%" y2="100%" stroke="#214080" stroke-width="2.5" />
                    </svg>
                </div>

                <!-- 3. Giám đốc -->
                <div class="bg-white border-2 border-[#214080] rounded-xl overflow-hidden shadow-lg text-center w-full max-w-[253px]">
                    <div class="w-full h-[285px] bg-slate-100 overflow-hidden">
                        <img src="/img/anhSoDoNhanSu003.webp" alt="Giám đốc Trần Văn Quân" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=400&q=80'">
                    </div>
                    <div class="bg-[#214080] text-white py-3 px-2">
                        <div class="text-[10px] font-bold uppercase tracking-wider">GIÁM ĐỐC</div>
                        <div class="text-xs font-extrabold uppercase mt-1">TRẦN VĂN QUÂN</div>
                    </div>
                </div>

                <!-- Line nối -->
                <div class="w-full h-6 relative -my-[2px] z-10">
                    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                        <line x1="50%" y1="0" x2="50%" y2="100%" stroke="#214080" stroke-width="2.5" />
                    </svg>
                </div>

                <!-- Tiêu đề phân khu khối phòng ban -->
                <div class="text-center text-xs font-bold text-[#214080] uppercase tracking-wider bg-slate-100 py-2.5 rounded-lg border border-gray-300 w-full max-w-[253px] shadow-sm relative z-20">
                    ▼ CÁC BAN ĐIỀU HÀNH &amp; PHÒNG BAN ▼
                </div>

                <!-- 4. KHU VỰC SLIDER -->
                <div class="relative w-full max-w-[253px] overflow-hidden rounded-xl shadow-md border-2 border-[#214080] bg-white mt-4 viki-mobile-slider">
                    
                    <!-- Wrapper chứa các slide -->
                    <div id="vikiSliderTrack" class="flex transition-transform duration-500 ease-in-out">
                        
                        <!-- Slide 1 -->
                        <div class="w-full shrink-0 text-center">
                            <div class="w-full h-[285px] bg-slate-100 overflow-hidden">
                                <img src="/img/anhSoDoNhanSu004.webp" alt="Các ban điều hành dự án" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=300&q=80'">
                            </div>
                            <div class="bg-[#214080] text-white py-3 px-2 h-20 flex flex-col justify-center">
                                <div class="text-[11px] font-bold uppercase tracking-wider">CÁC BAN ĐIỀU HÀNH DỰ ÁN</div>
                                <div class="text-xs font-extrabold uppercase mt-1">BAN QUẢN LÝ CÔNG TRÌNH</div>
                            </div>
                        </div>

                        <!-- Slide 2 -->
                        <div class="w-full shrink-0 text-center">
                            <div class="w-full h-[285px] bg-slate-100 overflow-hidden">
                                <img src="/img/anhSoDoNhanSu005.webp" alt="Phòng Quản lý Dự án" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=300&q=80'">
                            </div>
                            <div class="bg-[#214080] text-white py-3 px-2 h-20 flex flex-col justify-center">
                                <div class="text-[11px] font-bold uppercase tracking-wider">PHÒNG QUẢN LÝ DỰ ÁN</div>
                                <div class="text-xs font-extrabold uppercase mt-1">NGUYỄN HUY TIỆP</div>
                            </div>
                        </div>

                        <!-- Slide 3 -->
                        <div class="w-full shrink-0 text-center">
                            <div class="w-full h-[285px] bg-slate-100 overflow-hidden">
                                <img src="/img/anhSoDoNhanSu006.webp" alt="Phòng Tổ chức - Hành chính" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=300&q=80'">
                            </div>
                            <div class="bg-[#214080] text-white py-3 px-2 h-20 flex flex-col justify-center">
                                <div class="text-[11px] font-bold uppercase tracking-wider">PHÒNG TỔ CHỨC - HÀNH CHÍNH</div>
                                <div class="text-xs font-extrabold uppercase mt-1">TRẦN THỊ SUM</div>
                            </div>
                        </div>

                        <!-- Slide 4 -->
                        <div class="w-full shrink-0 text-center">
                            <div class="w-full h-[285px] bg-slate-100 overflow-hidden">
                                <img src="/img/anhSoDoNhanSu007.webp" alt="Phòng Tài chính - Kế toán" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=300&q=80'">
                            </div>
                            <div class="bg-[#214080] text-white py-3 px-2 h-20 flex flex-col justify-center">
                                <div class="text-[11px] font-bold uppercase tracking-wider">PHÒNG TÀI CHÍNH - KẾ TOÁN</div>
                                <div class="text-xs font-extrabold uppercase mt-1">TRẦN THANH HƯƠNG</div>
                            </div>
                        </div>

                        <!-- Slide 5 -->
                        <div class="w-full shrink-0 text-center">
                            <div class="w-full h-[285px] bg-slate-100 overflow-hidden">
                                <img src="/img/anhSoDoNhanSu008.webp" alt="Phòng Vật tư - Thiết bị" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1581092335397-9583fe92d232?auto=format&fit=crop&w=300&q=80'">
                            </div>
                            <div class="bg-[#214080] text-white py-3 px-2 h-20 flex flex-col justify-center">
                                <div class="text-[11px] font-bold uppercase tracking-wider">PHÒNG VẬT TƯ - THIẾT BỊ</div>
                                <div class="text-xs font-extrabold uppercase mt-1">NGUYỄN THỊ CẨM TÚ</div>
                            </div>
                        </div>

                    </div>

                    <!-- Nút điều hướng Slide trái/phải -->
                    <button onclick="vikiPrevSlide()" class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/75 text-white w-8 h-8 rounded-full flex items-center justify-center text-sm shadow-md transition">‹</button>
                    <button onclick="vikiNextSlide()" class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/75 text-white w-8 h-8 rounded-full flex items-center justify-center text-sm shadow-md transition">›</button>

                    <!-- Các chấm chỉ mục (Dots indicator) -->
                    <div class="absolute bottom-24 left-0 right-0 flex justify-center gap-1.5 pointer-events-none">
                        <span class="viki-dot w-2 h-2 rounded-full bg-white/60 transition-all duration-300"></span>
                        <span class="viki-dot w-2 h-2 rounded-full bg-white/60 transition-all duration-300"></span>
                        <span class="viki-dot w-2 h-2 rounded-full bg-white/60 transition-all duration-300"></span>
                        <span class="viki-dot w-2 h-2 rounded-full bg-white/60 transition-all duration-300"></span>
                        <span class="viki-dot w-2 h-2 rounded-full bg-white/60 transition-all duration-300"></span>
                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- SECTION 1: GIÁ TRỊ CỐT LÕI (CORE VALUES) -->
    <section class="py-20 bg-white border-b border-[#E6EAF2] w-full max-w-full overflow-hidden" id="core-values">
        <div class="container mx-auto px-4 w-full max-w-full">
            
            <div class="flex items-center gap-3 mb-12 pb-4 border-b-2 border-[#16315E]">
                <img src="/icon-hamburger-blue.png" alt="Icon" class="w-8 h-8 object-contain">
                <h2 class="text-xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide break-words">
                    GIÁ TRỊ CỐT LÕI
                </h2>
            </div>

