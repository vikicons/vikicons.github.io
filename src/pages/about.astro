---
import Layout from '../layouts/layout.astro';
---

<Layout title="Về Chúng Tôi | VIKI Construction Corporation">

    <!-- HERO BANNER -->
    <section class="bg-[#16315E] text-white pt-12 pb-16 relative overflow-hidden border-b-4 border-[#FFC709]">
        <div class="container mx-auto px-4 relative z-10">
            
            <!-- Hero Main Headline kết hợp nút Hồ Sơ Năng Lực 2026 bên phải -->
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
                
                <!-- Phần tiêu đề và mô tả bên trái -->
                <div class="max-w-4xl">
                    <div class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#5FD1C1] mb-3">BUILDING FUTURES</div>
                    <h1 class="text-[59px] font-extrabold uppercase tracking-tight leading-[1.15] mb-6">
                        <span class="block mb-2">Chúng tôi là VIKI</span>
                        <span class="text-[#38B6FF] whitespace-nowrap block">Xây Giá Trị – Dựng Niềm Tin</span>
                    </h1>
                    <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-light text-justify max-w-3xl">
                        Công ty Cổ phần Xây dựng VIKI chính thức thành lập vào ngày 01 tháng 6 năm 2020. Dù ra đời trong bối cảnh thị trường nhiều thách thức, VIKI đã chọn con đường phát triển lấy uy tín và chất lượng làm nền tảng hàng đầu, không ngừng vươn mình trở thành đối tác tin cậy của các tập đoàn đa quốc gia.
                    </p>
                </div>

                <!-- Nút Tải Hồ Sơ Năng Lực 2026 nằm ở chính giữa bên phải -->
                <div class="flex lg:justify-center shrink-0">
                    <a href="https://drive.google.com/file/d/1cxkXAJ90zEEOfl1jduVt6gi3GFYggogX/view?usp=sharing" 
                       target="_blank" 
                       rel="noopener noreferrer" 
                       class="inline-flex items-center justify-center gap-3 bg-[#264ABC] hover:bg-[#214080] text-white px-6 py-4 text-sm font-bold uppercase tracking-wider transition no-underline border border-white/20 rounded shadow-lg">
                        <span>HỒ SƠ NĂNG LỰC 2026</span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </a>
                </div>

            </div>

        </div>
    </section>

    <!-- SECTION 1: GIÁ TRỊ CỐT LÕI (CORE VALUES) -->
    <section class="py-20 bg-white border-b border-[#E6EAF2]" id="core-values">
        <div class="container mx-auto px-4">
            
            <div class="flex items-center gap-3 mb-12 pb-4 border-b-2 border-[#16315E]">
                <img src="/icon-hamburger-blue.png" alt="Icon" class="w-8 h-8 object-contain">
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide">
                    GIÁ TRỊ CỐT LÕI
                </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <!-- Giá trị 1: Uy tín -->
                <div class="p-8 bg-[#FAF9F9] border-t-4 border-[#214080] shadow-sm hover:shadow-md transition">
                    <div class="text-4xl mb-4 font-black text-[#214080]">01</div>
                    <h3 class="text-xl font-bold uppercase text-[#16315E] mb-3">REPUTATION — UY TÍN</h3>
                    <p class="text-sm text-[#5A6E85] leading-relaxed text-justify m-0">
                        Uy tín là nền tảng sống còn cho sự phát triển của VIKI. Chúng tôi giữ vững mọi cam kết về chất lượng, tiến độ và độ an toàn trên từng công trình đối với khách hàng và đối tác.
                    </p>
                </div>

                <!-- Giá trị 2: Chất lượng -->
                <div class="p-8 bg-[#FAF9F9] border-t-4 border-[#38B6FF] shadow-sm hover:shadow-md transition">
                    <div class="text-4xl mb-4 font-black text-[#38B6FF]">02</div>
                    <h3 class="text-xl font-bold uppercase text-[#16315E] mb-3">QUALITY — CHẤT LƯỢNG</h3>
                    <p class="text-sm text-[#5A6E85] leading-relaxed text-justify m-0">
                        Chất lượng là lợi thế cạnh tranh cốt lõi. Áp dụng nghiêm ngặt các tiêu chuẩn kỹ thuật hiện đại, quy trình thi công chuẩn xác để mang lại sản phẩm đạt độ bền vững tối ưu.
                    </p>
                </div>

                <!-- Giá trị 3: Sức trẻ -->
                <div class="p-8 bg-[#FAF9F9] border-t-4 border-[#ED2424] shadow-sm hover:shadow-md transition">
                    <div class="text-4xl mb-4 font-black text-[#ED2424]">03</div>
                    <h3 class="text-xl font-bold uppercase text-[#16315E] mb-3">YOUTHFULNESS — SỨC TRẺ</h3>
                    <p class="text-sm text-[#5A6E85] leading-relaxed text-justify m-0">
                        Nhiệt huyết, dám nghĩ, dám làm. Đội ngũ nhân sự trẻ trung, sáng tạo và chủ động là tài sản vô giá, là nhân tố quyết định mang lại những đột phá thành công cho doanh nghiệp.
                    </p>
                </div>

            </div>

        </div>
    </section>

    <!-- SECTION 2: TẦM NHÌN VÀ SỨ MỆNH (VISION & MISSION) -->
    <section class="py-20 bg-[#F4F6FA] border-b border-[#E6EAF2]" id="vision-mission">
        <div class="container mx-auto px-4">
            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-stretch">
                
                <!-- Cột Trái: Tầm Nhìn -->
                <div class="lg:col-span-5 bg-[#16315E] text-white p-8 sm:p-10 flex flex-col justify-between shadow-xl relative overflow-hidden">
                    <div>
                        <div class="text-xs font-bold text-[#5FD1C1] uppercase tracking-widest mb-2">ĐỊNH HƯỚNG TƯƠNG LAI</div>
                        <h2 class="text-3xl font-extrabold uppercase tracking-wide mb-6">TẦM NHÌN STRATEGIC</h2>
                        
                        <div class="space-y-6">
                            <div class="flex items-start gap-4 pb-4 border-b border-white/15">
                                <span class="text-3xl font-black text-[#38B6FF]">2030</span>
                                <p class="text-sm text-slate-200 leading-relaxed m-0">
                                    Trở thành doanh nghiệp trong <strong class="text-white">TOP 100</strong> doanh nghiệp xây dựng có quy mô và phát triển nhất tại Việt Nam.
                                </p>
                            </div>

                            <div class="flex items-start gap-4">
                                <span class="text-3xl font-black text-[#5FD1C1]">2040</span>
                                <p class="text-sm text-slate-200 leading-relaxed m-0">
                                    Vươn mình vào <strong class="text-white">TOP 50</strong> doanh nghiệp xây dựng hàng đầu Việt Nam và phát triển thành tập đoàn đa ngành nghề vững mạnh.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 pt-6 border-t border-white/10 text-xs text-slate-300 italic">
                        "Khẳng định thương hiệu trên thị trường xây dựng Việt Nam và vươn tầm quốc tế."
                    </div>
                </div>

                <!-- Cột Phải: Sứ Mệnh 4 Bên -->
                <div class="lg:col-span-7 bg-white p-8 sm:p-10 border border-[#E6EAF2] shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="text-xs font-bold text-[#264ABC] uppercase tracking-widest mb-2">TRÁCH NHIỆM & CAM KẾT</div>
                        <h2 class="text-3xl font-extrabold uppercase text-[#16315E] tracking-wide mb-6">SỨ MỆNH VIKI</h2>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            
                            <div class="p-4 bg-[#FAF9F9] border-l-3 border-[#214080]">
                                <h4 class="font-bold text-[#16315E] uppercase text-sm mb-1">Đối với Khách hàng</h4>
                                <p class="text-xs text-[#5A6E85] leading-relaxed m-0">Tôn trọng và cam kết mang đến cho khách hàng những dự án thi công tối ưu nhất về chất lượng và chi phí.</p>
                            </div>

                            <div class="p-4 bg-[#FAF9F9] border-l-3 border-[#38B6FF]">
                                <h4 class="font-bold text-[#16315E] uppercase text-sm mb-1">Đối với Đối tác</h4>
                                <p class="text-xs text-[#5A6E85] leading-relaxed m-0">Xây dựng mối quan hệ tin cậy, uy tín, minh bạch và hợp tác cùng phát triển bền vững lâu dài.</p>
                            </div>

                            <div class="p-4 bg-[#FAF9F9] border-l-3 border-[#ED2424]">
                                <h4 class="font-bold text-[#16315E] uppercase text-sm mb-1">Đối với Nhân viên</h4>
                                <p class="text-xs text-[#5A6E85] leading-relaxed m-0">Tạo môi trường làm việc thân thiện, chuyên nghiệp, tự giác để mỗi cá nhân phát huy tối đa năng lực.</p>
                            </div>

                            <div class="p-4 bg-[#FAF9F9] border-l-3 border-[#40C08D]">
                                <h4 class="font-bold text-[#16315E] uppercase text-sm mb-1">Đối với Xã hội</h4>
                                <p class="text-xs text-[#5A6E85] leading-relaxed m-0">Gắn liền lợi ích doanh nghiệp với lợi ích cộng đồng, tích cực thực hiện các hoạt động đóng góp cho xã hội.</p>
                            </div>

                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- SECTION 3: THÔNG ĐIỆP BAN LÃNH ĐẠO (PREFACE / BAN LÃNH ĐẠO) -->
    <section class="py-20 bg-white border-b border-[#E6EAF2]" id="leadership">
        <div class="container mx-auto px-4">
            
            <div class="flex items-center gap-3 mb-12 pb-4 border-b-2 border-[#16315E]">
                <img src="/icon-hamburger-blue.png" alt="Icon" class="w-8 h-8 object-contain">
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide">
                    THÔNG ĐIỆP TỪ BAN LÃNH ĐẠO
                </h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                
                <!-- Ảnh Đại Diện / Ban Lãnh Đạo -->
                <div class="lg:col-span-5">
                    <div class="relative rounded-xl overflow-hidden shadow-2xl border-4 border-[#F4F6FA]">
                        <img src="/img/anhSoDoNhanSu008.webp" alt="Ban Lãnh Đạo VIKI" class="w-full h-[420px] object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-[#16315E]/90 via-transparent to-transparent flex flex-col justify-end p-6 text-white">
                            <h3 class="text-xl font-bold uppercase m-0">BAN LÃNH ĐẠO VIKI</h3>
                            <p class="text-xs text-[#5FD1C1] font-medium m-0">Công Ty Cổ Phần Xây Dựng VIKI</p>
                        </div>
                    </div>
                </div>

                <!-- Thư Ngỏ Content -->
                <div class="lg:col-span-7 space-y-4 text-[#5A6E85] text-sm sm:text-base leading-relaxed text-justify">
                    <p class="italic text-[#16315E] font-semibold text-lg border-l-4 border-[#264ABC] pl-4 py-1">
                        "Trong thời gian tới, Việt Nam tiếp tục hội nhập mạnh mẽ với thế giới, mang đến vô vàn cơ hội lẫn thách thức phía trước..."
                    </p>
                    <p>
                        Công ty Cổ phần Xây dựng VIKI hoạt động chính trong lĩnh vực xây dựng dân dụng & công nghiệp, thiết kế các công trình công nghiệp và lập dự án đầu tư. Chúng tôi không ngừng lắng nghe, nghiêm túc phấn đấu nâng cao chất lượng phục vụ và cải tiến quy trình quản lý vì sự hài lòng của khách hàng.
                    </p>
                    <p>
                        Tuy là doanh nghiệp trẻ, VIKI đang từng bước khẳng định vị thế nhờ nền tảng phát triển bền vững và tuân thủ tuyệt đối các chuẩn mực kinh doanh. Đội ngũ cán bộ nhân viên luôn tu dưỡng và ý thức rõ sứ mệnh phục vụ cộng đồng. Phương châm <strong class="text-[#16315E]">"Uy tín – Chất lượng – Sức trẻ"</strong> luôn là kim chỉ nam cho mọi hoạt động thi công thực tế.
                    </p>
                    <p class="font-medium text-[#16315E] pt-2">
                        Chúng tôi hy vọng sẽ tiếp tục nhận được sự tin tưởng và đồng hành của Quý đối tác, Khách hàng trên con đường mang tên Thành Công.
                    </p>
                </div>

            </div>

        </div>
    </section>

    <!-- SECTION 4: HÀNH TRÌNH VÀ CỘT MỐC CỦA CHÚNG TÔI -->
    <section class="py-20 bg-[#FAF9F9] border-b border-[#E6EAF2]" id="milestones">
        <div class="container mx-auto px-4">
            
            <div class="flex items-center gap-3 mb-12 pb-4 border-b-2 border-[#16315E]">
                <img src="/icon-hamburger-blue.png" alt="Icon" class="w-8 h-8 object-contain">
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide">
                    HÀNH TRÌNH PHÁT TRIỂN
                </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <div class="bg-white p-8 border border-[#E6EAF2] shadow-sm relative">
                    <div class="text-xs font-bold text-[#264ABC] uppercase tracking-widest mb-1">01/06/2020</div>
                    <h3 class="text-2xl font-extrabold text-[#16315E] mb-3">CỘT MỐC RA ĐỜI</h3>
                    <p class="text-sm text-[#5A6E85] leading-relaxed text-justify m-0">
                        VIKI Construction được thành lập trong hoàn cảnh nền kinh tế đối mặt với nhiều biến động. Với sứ mệnh biến thách thức thành cơ hội, công ty ra đời nhằm cống hiến sức trẻ cho sự phát triển đất nước.
                    </p>
                </div>

                <div class="bg-white p-8 border border-[#E6EAF2] shadow-sm relative">
                    <div class="text-xs font-bold text-[#264ABC] uppercase tracking-widest mb-1">2021 — 2024</div>
                    <h3 class="text-2xl font-extrabold text-[#16315E] mb-3">TẠO DỰNG NIỀM TIN</h3>
                    <p class="text-sm text-[#5A6E85] leading-relaxed text-justify m-0">
                        Thi công hoàn thành hàng loạt dự án quy mô lớn cho các tập đoàn toàn cầu như KSP Hải Dương, AAC Vĩnh Phúc, AAC Bắc Giang, Trang trại Vĩnh Tân Bình Dương và CP Bình Định.
                    </p>
                </div>

                <div class="bg-white p-8 border border-[#E6EAF2] shadow-sm relative">
                    <div class="text-xs font-bold text-[#264ABC] uppercase tracking-widest mb-1">2025 — 2026+</div>
                    <h3 class="text-2xl font-extrabold text-[#16315E] mb-3">BỨC PHÁ VƯƠN XA</h3>
                    <p class="text-sm text-[#5A6E85] leading-relaxed text-justify m-0">
                        Trúng thầu thi công siêu dự án Nhà máy & Kho BFF (242,5 tỷ VNĐ) và các gói thầu công nghiệp công nghệ cao, hiện thực hóa mục tiêu tiến vào TOP 100 doanh nghiệp xây dựng Việt Nam.
                    </p>
                </div>

            </div>

        </div>
    </section>

    <!-- SECTION 6: ĐỘI NGŨ NHÂN SỰ & NĂNG LỰC CON NGƯỜI -->
    <section class="py-20 bg-[#F4F6FA] border-b border-[#E6EAF2]" id="team-capabilities">
        <div class="container mx-auto px-4">
            
            <div class="flex items-center gap-3 mb-12 pb-4 border-b-2 border-[#16315E]">
                <img src="/icon-hamburger-blue.png" alt="Icon" class="w-8 h-8 object-contain">
                <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide">
                    ĐỘI NGŨ VIKI & NĂNG LỰC CON NGƯỜI
                </h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <div class="bg-white p-8 border border-[#E6EAF2] shadow-sm">
                    <div class="w-12 h-12 bg-[#16315E] text-white flex items-center justify-center font-bold text-xl mb-4">1</div>
                    <h3 class="text-xl font-bold text-[#16315E] uppercase mb-2">Kinh Nghiệm Quản Lý</h3>
                    <p class="text-sm text-[#5A6E85] leading-relaxed text-justify m-0">
                        Đội ngũ quản lý giàu kinh nghiệm chuyên môn trong công tác vận hành và thi công. Các cá nhân đã trải qua hàng loạt công trình lớn nhỏ đa dạng quy mô.
                    </p>
                </div>

                <div class="bg-white p-8 border border-[#E6EAF2] shadow-sm">
                    <div class="w-12 h-12 bg-[#264ABC] text-white flex items-center justify-center font-bold text-xl mb-4">2</div>
                    <h3 class="text-xl font-bold text-[#16315E] uppercase mb-2">Chất Lượng Đào Tạo</h3>
                    <p class="text-sm text-[#5A6E85] leading-relaxed text-justify m-0">
                        Nguồn nhân lực trẻ được đào tạo bài bản từ lý thuyết đến thực hành công trường. Mỗi thành viên luôn nâng cao tay nghề để tích cực đóng góp cho doanh nghiệp.
                    </p>
                </div>

                <div class="bg-white p-8 border border-[#E6EAF2] shadow-sm">
                    <div class="w-12 h-12 bg-[#38B6FF] text-white flex items-center justify-center font-bold text-xl mb-4">3</div>
                    <h3 class="text-xl font-bold text-[#16315E] uppercase mb-2">Trình Độ Chuyên Môn</h3>
                    <p class="text-sm text-[#5A6E85] leading-relaxed text-justify m-0">
                        VIKI sở hữu đội ngũ đông đảo kiến trúc sư, kỹ sư được biên chế chính thức, làm việc thường trực tại văn phòng và trực tiếp chỉ đạo tại các công trình.
                    </p>
                </div>

            </div>

        </div>
    </section>

</Layout>