---
import Layout from '../layouts/layout.astro';
---

<Layout title="404 - Trang Đang Cập Nhật | VIKI Construction">
    <section class="py-10 bg-[#F8F9FA] min-h-[70vh] flex items-center">
        <div class="container mx-auto px-4"> 
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                
                <div class="relative bg-white p-8 border border-[#E6EAF2] shadow-sm flex flex-col items-center justify-center min-h-[380px]">
                    <div class="w-full max-w-[280px] sm:max-w-[340px] mb-3 mx-auto">
                        <img src="/404error.webp" alt="404 Error Illustration" class="w-full h-auto object-contain drop-shadow-md transition-transform duration-300 hover:scale-105" />
                    </div>

                    <div class="mt-6 flex items-center gap-3 text-slate-500 text-xs font-semibold uppercase tracking-wider">
                        <span class="w-3 h-3 bg-amber-500 rounded-full animate-ping"></span> <span data-key="err404_badge">VIKI DIGITAL TRANSFORMATION 2026</span>
                    </div>
                </div>

                <div>
                    <span class="text-[#264ABC] text-xs font-bold uppercase tracking-[0.2em] mb-3 block" data-key="err404_portal">VIKI SYSTEM PORTAL</span>
                    <h1 class="text-3xl sm:text-4xl font-extrabold text-[#16315E] mb-4 uppercase leading-tight" data-key="err404_title">
                        HẠNG MỤC ĐANG <br/>THI CÔNG NỘI DUNG
                    </h1>
                    <p class="text-base text-[#5A6E85] leading-relaxed mb-8" data-key="err404_desc">
                        Trang bạn vừa chọn hiện đang trong kế hoạch nâng cấp cơ sở dữ liệu và tích hợp các thông số kỹ thuật mới nhất từ Công Ty Cổ Phần Xây Dựng VIKI. Vui lòng quay lại trang chủ hoặc liên hệ trực tiếp với bộ phận tư vấn để nhận thông tin chi tiết.
                    </p>
                    
                    <div class="flex flex-wrap items-center gap-4">
                        <a href="/" class="bg-red-600 border-2 border-red-600 text-white hover:bg-[#264ABC] hover:border-[#264ABC] hover:text-white py-3.5 px-6 text-sm font-bold uppercase tracking-wider transition shadow-md block text-center w-full sm:w-60" data-key="err404_btn_home">
                            TRỞ VỀ TRANG CHỦ
                        </a>
                        
                        <a href="/contact" class="bg-white border-2 border-[#16315E] text-[#16315E] hover:bg-[#16315E] hover:border-[#16315E] hover:text-white py-3.5 px-6 text-sm font-bold uppercase tracking-wider transition block text-center w-full sm:w-60" data-key="err404_btn_contact">
                            LIÊN HỆ HỖ TRỢ
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>
</Layout>