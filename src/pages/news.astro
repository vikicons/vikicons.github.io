---
import Layout from '../layouts/layout.astro';
import rawNewsData from '../data/all_news.json';

// Kiểm tra dữ liệu an toàn phòng ngừa file JSON rỗng hoặc lỗi cú pháp
const allNews = Array.isArray(rawNewsData) ? rawNewsData : [];

// Nhãn hiển thị cho từng mã danh mục
const categoryLabels: Record<string, string> = {
    'executive-direction': 'Chỉ đạo điều hành',
    'architecture-planning': 'Quy hoạch kiến trúc',
    'building-materials': 'Vật liệu xây dựng',
    'quality-inspection': 'Giám định chất lượng',
    'urban-management': 'Quản lý đô thị',
    'construction-news': 'Tin Xây Dựng',
};
const getLabel = (cat?: string) => categoryLabels[cat || ''] || 'Tin Xây Dựng';

// Chuyển "dd/mm/yyyy" thành mốc thời gian (ms) để sắp xếp
const toTimestamp = (item: any) => {
    if (typeof item.timestamp === 'number' && item.timestamp > 0) {
        return Math.round(item.timestamp * 1000);
    }
    const parts = (item.date || '').split('/');
    if (parts.length === 3) {
        const t = new Date(`${parts[2]}-${parts[1]}-${parts[0]}`).getTime();
        return Number.isNaN(t) ? 0 : t;
    }
    return 0;
};

// Bài viết nổi bật đầu tiên làm Hero
const featuredNews = allNews[0] || {
    title: "Đang cập nhật tin tức xây dựng...",
    link: "https://baoxaydung.vn/xay-dung.htm",
    date: "",
    category: "construction-news",
    image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=800&q=80"
};

// Các bài viết tiếp theo đưa vào lưới tin tức
const gridNews = allNews.slice(1);
---

<Layout title="Tin Tức | VIKI Construction Corporation">

    <div class="bg-[#FAF9F9] min-h-screen py-12">
        <div class="container mx-auto px-4 max-w-7xl">

            <!-- PAGE TITLE -->
            <div class="mb-8">
                <h1 class="text-[40px] sm:text-[59px] font-extrabold uppercase tracking-tight leading-[1.15] mb-6 text-[#16315E]">
                    TIN TỨC
                </h1>
                <div class="w-16 h-1 bg-[#ED2424] mt-3"></div>
            </div>

            <!-- FEATURED NEWS HERO -->
            <a href={featuredNews.link} target="_blank" rel="noopener noreferrer"
               class="block bg-white border border-[#E6EAF2] rounded-xl overflow-hidden shadow-sm mb-10 group cursor-pointer">
                <div class="h-[320px] sm:h-[450px] w-full overflow-hidden bg-slate-200">
                    <img src={featuredNews.image} alt={featuredNews.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                </div>
                <div class="p-6 sm:p-8">
                    <div class="flex items-center gap-4 text-xs font-bold text-[#214080] uppercase mb-2">
                        <span class="bg-[#214080] text-white px-2.5 py-1 rounded">{getLabel(featuredNews.category)}</span>
                        <span class="text-[#5A6E85]">{featuredNews.date}</span>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-bold uppercase text-[#16315E] leading-snug group-hover:text-[#264ABC] transition">
                        {featuredNews.title}
                    </h2>
                </div>
            </a>

            <!-- FILTER NAVIGATION BAR -->
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-10 pb-4 border-b border-gray-200 text-xs sm:text-sm">
                <div class="flex flex-wrap items-center gap-2 sm:gap-6 font-semibold uppercase text-[#5A6E85]" id="category-filters">
                    <button class="cat-btn text-[#214080] font-bold border-b-2 border-[#214080] pb-1 bg-transparent cursor-pointer transition" data-category="all">Tất cả tin tức</button>
                    <button class="cat-btn border-b-2 border-transparent pb-1 hover:text-[#214080] transition bg-transparent cursor-pointer" data-category="executive-direction">Chỉ đạo điều hành</button>
                    <button class="cat-btn border-b-2 border-transparent pb-1 hover:text-[#214080] transition bg-transparent cursor-pointer" data-category="architecture-planning">Quy hoạch kiến trúc</button>
                    <button class="cat-btn border-b-2 border-transparent pb-1 hover:text-[#214080] transition bg-transparent cursor-pointer" data-category="building-materials">Vật liệu xây dựng</button>
                    <button class="cat-btn border-b-2 border-transparent pb-1 hover:text-[#214080] transition bg-transparent cursor-pointer" data-category="quality-inspection">Giám định chất lượng</button>
                    <button class="cat-btn border-b-2 border-transparent pb-1 hover:text-[#214080] transition bg-transparent cursor-pointer" data-category="urban-management">Quản lý đô thị</button>
                </div>

                <!-- Bộ lọc Sắp xếp -->
                <div class="flex items-center gap-2 text-xs font-bold text-[#16315E]">
                    <span>SẮP XẾP:</span>
                    <select id="sort-order" class="bg-white border border-gray-300 rounded px-3 py-1.5 text-xs outline-none cursor-pointer">
                        <option value="newest">Mới nhất trước</option>
                        <option value="oldest">Cũ nhất trước</option>
                    </select>
                </div>
            </div>

            <!-- NEWS GRID -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12" id="news-grid">
                {gridNews.map((item) => (
                    <a href={item.link} target="_blank" rel="noopener noreferrer"
                       class="news-card bg-white border border-[#E6EAF2] rounded-xl overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group cursor-pointer"
                       data-category={item.category || ''}
                       data-timestamp={toTimestamp(item)}>
                        <div class="h-48 overflow-hidden bg-slate-200">
                            <img src={item.image} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                        </div>
                        <div class="p-6 flex-1 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between text-[11px] font-bold text-[#5A6E85] mb-2 uppercase">
                                    <span class="text-[#214080]">{getLabel(item.category)}</span>
                                    <span>{item.date}</span>
                                </div>
                                <h3 class="text-base font-bold uppercase text-[#16315E] leading-snug group-hover:text-[#264ABC] transition line-clamp-3">
                                    {item.title}
                                </h3>
                            </div>
                        </div>
                    </a>
                ))}
            </div>

            <!-- EMPTY STATE: nằm NGOÀI lưới, chỉ ẩn/hiện, không xóa nội dung lưới -->
            <div id="empty-state" class="hidden py-16 text-center text-gray-500 bg-white rounded-xl border border-[#E6EAF2] mb-12">
                <p class="text-base font-semibold">Hiện tại danh mục này chưa có bản tin nào.</p>
                <p class="text-xs mt-1 text-gray-400">Vui lòng chọn mục "Tất cả tin tức" hoặc quay lại sau.</p>
            </div>

            <!-- PAGINATION CONTAINER -->
            <div class="flex items-center justify-center gap-2 pt-0 pb-0" id="pagination-container"></div>

        </div>
    </div>

</Layout>

<script>
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
    const sortOrderSelect = document.getElementById('sort-order') as HTMLSelectElement | null;
    const newsGrid = document.getElementById('news-grid');
    const paginationContainer = document.getElementById('pagination-container');
    const emptyState = document.getElementById('empty-state');

    // QUAN TRỌNG: lưu danh sách thẻ MỘT LẦN khi trang tải.
    // Không đọc lại từ newsGrid mỗi lần lọc, vì lưới chỉ chứa các thẻ đang hiển thị.
    const allCards: HTMLElement[] = newsGrid
        ? Array.from(newsGrid.querySelectorAll<HTMLElement>('.news-card'))
        : [];

    const ACTIVE_CLASS = 'cat-btn text-[#214080] font-bold border-b-2 border-[#214080] pb-1 bg-transparent cursor-pointer transition';
    const INACTIVE_CLASS = 'cat-btn border-b-2 border-transparent pb-1 hover:text-[#214080] transition bg-transparent cursor-pointer';

    let currentCategory = 'all';
    let currentPage = 1;
    const itemsPerPage = 6;

    function filterAndPaginate() {
        if (!newsGrid || !paginationContainer) return;

        // Lọc theo mã danh mục chính xác
        const filteredCards = allCards.filter(card => {
            if (currentCategory === 'all') return true;
            return (card.dataset.category || '').trim().toLowerCase() === currentCategory;
        });

        // Sắp xếp Mới nhất / Cũ nhất
        const sortOrder = sortOrderSelect ? sortOrderSelect.value : 'newest';
        filteredCards.sort((a, b) => {
            const timeA = parseInt(a.dataset.timestamp || '0', 10);
            const timeB = parseInt(b.dataset.timestamp || '0', 10);
            return sortOrder === 'newest' ? timeB - timeA : timeA - timeB;
        });

        // Danh mục rỗng: chỉ hiện thông báo, KHÔNG xóa các thẻ gốc (chúng vẫn nằm trong allCards)
        if (filteredCards.length === 0) {
            newsGrid.replaceChildren();
            emptyState?.classList.remove('hidden');
            paginationContainer.innerHTML = '';
            return;
        }
        emptyState?.classList.add('hidden');

        // Đặt lại lưới theo thứ tự đã lọc và sắp xếp
        newsGrid.replaceChildren(...filteredCards);

        const totalPages = Math.ceil(filteredCards.length / itemsPerPage);
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        renderPagination(filteredCards, totalPages);
        updateView(filteredCards);
    }

    function renderPagination(filteredCards: HTMLElement[], totalPages: number) {
        if (!paginationContainer) return;
        paginationContainer.innerHTML = '';

        if (totalPages <= 1) return;

        const prevBtn = document.createElement('button');
        prevBtn.innerHTML = '&larr;';
        prevBtn.className = `w-10 h-10 flex items-center justify-center border border-gray-300 bg-white text-gray-500 hover:bg-gray-100 transition rounded cursor-pointer ${currentPage === 1 ? 'opacity-50 cursor-not-allowed' : ''}`;
        prevBtn.onclick = () => {
            if (currentPage > 1) {
                currentPage--;
                renderPagination(filteredCards, totalPages);
                updateView(filteredCards);
            }
        };
        paginationContainer.appendChild(prevBtn);

        const maxVisiblePages = 10;
        let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
        let endPage = startPage + maxVisiblePages - 1;

        if (endPage > totalPages) {
            endPage = totalPages;
            startPage = Math.max(1, endPage - maxVisiblePages + 1);
        }

        for (let i = startPage; i <= endPage; i++) {
            const pageBtn = document.createElement('button');
            pageBtn.innerText = i.toString();

            if (i === currentPage) {
                pageBtn.className = 'w-10 h-10 flex items-center justify-center bg-[#214080] text-white font-bold rounded cursor-pointer shadow-sm';
            } else {
                pageBtn.className = 'w-10 h-10 flex items-center justify-center border border-gray-300 bg-white text-[#214080] hover:bg-gray-100 transition rounded font-semibold cursor-pointer';
            }

            pageBtn.onclick = () => {
                currentPage = i;
                renderPagination(filteredCards, totalPages);
                updateView(filteredCards);
            };
            paginationContainer.appendChild(pageBtn);
        }

        const nextBtn = document.createElement('button');
        nextBtn.innerHTML = '&rarr;';
        nextBtn.className = `w-10 h-10 flex items-center justify-center border border-gray-300 bg-white text-gray-500 hover:bg-gray-100 transition rounded cursor-pointer ${currentPage === totalPages ? 'opacity-50 cursor-not-allowed' : ''}`;
        nextBtn.onclick = () => {
            if (currentPage < totalPages) {
                currentPage++;
                renderPagination(filteredCards, totalPages);
                updateView(filteredCards);
            }
        };
        paginationContainer.appendChild(nextBtn);
    }

    function updateView(filteredCards: HTMLElement[]) {
        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;

        filteredCards.forEach((card, index) => {
            // '' trả về kiểu hiển thị mặc định của class (flex flex-col)
            card.style.display = index >= startIndex && index < endIndex ? '' : 'none';
        });
    }

    catButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            catButtons.forEach(b => { b.className = INACTIVE_CLASS; });
            btn.className = ACTIVE_CLASS;

            currentCategory = btn.dataset.category || 'all';
            currentPage = 1;
            filterAndPaginate();
        });
    });

    sortOrderSelect?.addEventListener('change', () => {
        currentPage = 1;
        filterAndPaginate();
    });

    filterAndPaginate();
</script>