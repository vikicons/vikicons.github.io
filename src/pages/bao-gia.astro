---
import Layout from '../layouts/layout.astro';
---

<Layout title="Yêu Cầu Báo Giá Xây Dựng - VIKI Construction">

    <!-- HERO SECTION -->
    <section class="relative bg-[#16315E] text-white overflow-hidden">
        <div class="relative min-h-[320px] md:min-h-[380px] flex items-center">
            <img src="/img/slide001.png" alt="Yêu cầu báo giá xây dựng VIKI" class="absolute inset-0 w-full h-full object-cover brightness-[0.4] contrast-110">
            
            <div class="container mx-auto px-4 sm:px-12 md:px-20 relative z-10 py-16">
                <div class="max-w-3xl">
                    <div class="text-xs font-bold text-[#5FD1C1] uppercase tracking-widest mb-3">
                        <a href="/" class="hover:underline text-slate-300">Trang chủ</a> &gt; <span class="text-white">Báo giá</span>
                    </div>
                    <h1 class="text-3xl sm:text-5xl font-extrabold uppercase tracking-tight mb-4 leading-tight">
                        YÊU CẦU BÁO GIÁ XÂY DỰNG
                    </h1>
                    <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-light max-w-2xl">
                        VIKI cam kết mang đến giải pháp xây dựng tối ưu, phù hợp với nhu cầu và quy mô của từng công trình. Vui lòng điền thông tin dưới đây để chúng tôi tư vấn và gửi báo giá chi tiết nhất!
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- LĨNH VỰC HOẠT ĐỘNG SECTION -->
    <section class="py-16 bg-[#FAF9F9] border-b border-[#E6EAF2]">
        <div class="container mx-auto px-4 sm:px-8">
            <div class="mb-10">
                <span class="text-xs font-bold text-[#214080] uppercase tracking-widest block mb-1">LĨNH VỰC HOẠT ĐỘNG</span>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-[#16315E] uppercase tracking-tight">
                    CHÚNG TÔI CÓ THỂ HỖ TRỢ BẠN
                </h2>
                <p class="text-sm text-[#5A6E85] mt-2 max-w-2xl font-normal">
                    VIKI chuyên thi công các công trình công nghiệp, dân dụng và trang trại chăn nuôi với chất lượng vượt trội, tiến độ đảm bảo và chi phí tối ưu.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                
                <!-- Card 1 -->
                <div class="bg-white rounded-xl overflow-hidden shadow-md border border-[#E6EAF2] flex flex-col justify-between group">
                    <div>
                        <div class="h-48 overflow-hidden relative">
                            <img src="/img/chungToiLamGiHome002.png" alt="Xây dựng công nghiệp" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        </div>
                        <div class="p-6">
                            <div class="w-10 h-10 bg-[#214080] text-white rounded-lg flex items-center justify-center mb-4 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                            </div>
                            <h3 class="text-xl font-bold text-[#16315E] uppercase mb-2">Xây dựng công nghiệp</h3>
                            <p class="text-sm text-[#5A6E85] leading-relaxed">
                                Nhà xưởng, nhà kho, kết cấu thép, nhà máy, công trình phụ trợ.
                            </p>
                        </div>
                    </div>
                    <div class="px-6 pb-6 pt-0">
                        <a href="/services" class="inline-flex items-center gap-2 text-xs font-bold text-[#214080] uppercase tracking-wider hover:text-[#ED2424] transition group/link">
                            <span>Tìm hiểu thêm</span>
                            <span class="transition-transform group-hover/link:translate-x-1">→</span>
                        </a>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="bg-white rounded-xl overflow-hidden shadow-md border border-[#E6EAF2] flex flex-col justify-between group">
                    <div>
                        <div class="h-48 overflow-hidden relative">
                            <img src="/img/chungToiLamGiHome001.png" alt="Xây dựng dân dụng" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        </div>
                        <div class="p-6">
                            <div class="w-10 h-10 bg-[#214080] text-white rounded-lg flex items-center justify-center mb-4 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                            </div>
                            <h3 class="text-xl font-bold text-[#16315E] uppercase mb-2">Xây dựng dân dụng</h3>
                            <p class="text-sm text-[#5A6E85] leading-relaxed">
                                Nhà ở, văn phòng, công trình thương mại và các hạng mục dân dụng.
                            </p>
                        </div>
                    </div>
                    <div class="px-6 pb-6 pt-0">
                        <a href="/services" class="inline-flex items-center gap-2 text-xs font-bold text-[#214080] uppercase tracking-wider hover:text-[#ED2424] transition group/link">
                            <span>Tìm hiểu thêm</span>
                            <span class="transition-transform group-hover/link:translate-x-1">→</span>
                        </a>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="bg-white rounded-xl overflow-hidden shadow-md border border-[#E6EAF2] flex flex-col justify-between group">
                    <div>
                        <div class="h-48 overflow-hidden relative">
                            <img src="/img/chungToiLamGiHome003.png" alt="Trang trại chăn nuôi" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        </div>
                        <div class="p-6">
                            <div class="w-10 h-10 bg-[#214080] text-white rounded-lg flex items-center justify-center mb-4 shadow-md">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            </div>
                            <h3 class="text-xl font-bold text-[#16315E] uppercase mb-2">Trang trại chăn nuôi</h3>
                            <p class="text-sm text-[#5A6E85] leading-relaxed">
                                Chuồng trại, nhà phụ trợ, hệ thống thông gió, thoát nước và hạ tầng kỹ thuật.
                            </p>
                        </div>
                    </div>
                    <div class="px-6 pb-6 pt-0">
                        <a href="/services" class="inline-flex items-center gap-2 text-xs font-bold text-[#214080] uppercase tracking-wider hover:text-[#ED2424] transition group/link">
                            <span>Tìm hiểu thêm</span>
                            <span class="transition-transform group-hover/link:translate-x-1">→</span>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- FORM & INFO SECTION -->
    <section class="py-20 bg-white">
        <div class="container mx-auto px-4 sm:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- CỘT TRÁI: THÔNG TIN CAM KẾT & HOTLINE (Chiếm 5 phần) -->
                <div class="lg:col-span-5 bg-[#214080] text-white rounded-2xl p-8 lg:p-10 shadow-xl relative overflow-hidden flex flex-col justify-between">
                    <!-- Ảnh nền mờ trang trí -->
                    <div class="absolute inset-0 opacity-10 bg-cover bg-center pointer-events-none" style="background-image: url('/img/slide001.png');"></div>

                    <div class="relative z-10">
                        <span class="text-xs font-bold text-[#5FD1C1] tracking-widest uppercase block mb-2">VÌ MỘT CÔNG TRÌNH BỀN VỮNG</span>
                        <h3 class="text-2xl sm:text-3xl font-extrabold uppercase tracking-tight mb-6 leading-snug">
                            ĐỂ LẠI THÔNG TIN NHẬN BÁO GIÁ
                        </h3>
                        <p class="text-sm text-slate-200 leading-relaxed mb-8">
                            Hãy cho chúng tôi biết nhu cầu của bạn, đội ngũ VIKI sẽ liên hệ và tư vấn chi tiết trong thời gian sớm nhất!
                        </p>

                        <!-- Danh sách cam kết -->
                        <div class="space-y-6 mb-10">
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center shrink-0 border border-white/20">
                                    <svg class="w-5 h-5 text-[#5FD1C1]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                </div>
                                <div>
                                    <h4 class="font-bold text-base uppercase">Tư vấn giải pháp tối ưu</h4>
                                    <p class="text-xs text-slate-300 mt-0.5">Phù hợp với nhu cầu thực tế</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center shrink-0 border border-white/20">
                                    <svg class="w-5 h-5 text-[#5FD1C1]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                                </div>
                                <div>
                                    <h4 class="font-bold text-base uppercase">Đội ngũ kỹ sư, chuyên gia</h4>
                                    <p class="text-xs text-slate-300 mt-0.5">Nhiều năm kinh nghiệm thực chiến</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center shrink-0 border border-white/20">
                                    <svg class="w-5 h-5 text-[#5FD1C1]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                </div>
                                <div>
                                    <h4 class="font-bold text-base uppercase">Thi công đúng tiến độ</h4>
                                    <p class="text-xs text-slate-300 mt-0.5">Đảm bảo chất lượng kỹ thuật</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center shrink-0 border border-white/20">
                                    <svg class="w-5 h-5 text-[#5FD1C1]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                                </div>
                                <div>
                                    <h4 class="font-bold text-base uppercase">Hỗ trợ 24/7</h4>
                                    <p class="text-xs text-slate-300 mt-0.5">Trong suốt quá trình triển khai dự án</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hotline box -->
                    <div class="relative z-10 pt-6 border-t border-white/15 flex items-center gap-4">
                        <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center shrink-0 shadow-lg">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        </div>
                        <div>
                            <div class="text-xs text-slate-300 uppercase tracking-wider font-medium">Hotline tư vấn</div>
                            <a href="tel:0938123456" class="text-xl sm:text-2xl font-black text-white tracking-wide hover:text-[#5FD1C1] transition">0938 123 456</a>
                        </div>
                    </div>
                </div>

                <!-- CỘT PHẢI: FORM YÊU CẦU BÁO GIÁ (Chiếm 7 phần) -->
                <div class="lg:col-span-7 bg-white rounded-2xl p-6 sm:p-10 border border-[#E6EAF2] shadow-xl">
                    <div class="mb-8 pb-4 border-b border-[#E6EAF2]">
                        <h3 class="text-2xl font-extrabold text-[#16315E] uppercase tracking-wide">THÔNG TIN YÊU CẦU BÁO GIÁ</h3>
                        <p class="text-sm text-[#5A6E85] mt-1">Vui lòng điền đầy đủ thông tin để chúng tôi có thể tư vấn chính xác nhất.</p>
                    </div>

                    <form id="quoteForm" class="space-y-8">
                        
                        <!-- PHẦN 1: THÔNG TIN CÔNG TRÌNH -->
                        <div>
                            <h4 class="text-base font-bold text-[#16315E] uppercase tracking-wide mb-4 pb-2 border-b border-[#E6EAF2] flex items-center gap-2">
                                <span class="w-6 h-6 rounded-full bg-[#214080] text-white text-xs flex items-center justify-center">1</span>
                                <span>Thông tin công trình</span>
                            </h4>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                
                                <!-- Loại công trình -->
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold text-[#16315E] uppercase tracking-wider mb-2">Loại công trình <span class="text-red-600">*</span></label>
                                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                        <label class="flex items-center gap-2 text-sm text-[#16315E] cursor-pointer">
                                            <input type="radio" name="projectType" value="cong-nghiep" checked class="text-[#214080] focus:ring-[#214080]">
                                            <span>Xây dựng công nghiệp</span>
                                        </label>
                                        <label class="flex items-center gap-2 text-sm text-[#16315E] cursor-pointer">
                                            <input type="radio" name="projectType" value="dan-dung" class="text-[#214080] focus:ring-[#214080]">
                                            <span>Xây dựng dân dụng</span>
                                        </label>
                                        <label class="flex items-center gap-2 text-sm text-[#16315E] cursor-pointer">
                                            <input type="radio" name="projectType" value="chan-nuoi" class="text-[#214080] focus:ring-[#214080]">
                                            <span>Trang trại chăn nuôi</span>
                                        </label>
                                        <label class="flex items-center gap-2 text-sm text-[#16315E] cursor-pointer">
                                            <input type="radio" name="projectType" value="khac" class="text-[#214080] focus:ring-[#214080]">
                                            <span>Công trình khác</span>
                                        </label>
                                    </div>
                                </div>

                                <!-- Địa điểm xây dựng -->
                                <div>
                                    <label class="block text-xs font-bold text-[#16315E] uppercase tracking-wider mb-2">Địa điểm xây dựng <span class="text-red-600">*</span></label>
                                    <input type="text" required placeholder="Nhập tỉnh/thành phố, địa chỉ dự kiến" class="w-full bg-[#FAF9F9] border border-[#E6EAF2] rounded-lg px-4 py-3 text-sm text-[#16315E] focus:outline-none focus:border-[#214080] transition">
                                </div>

                                <!-- Diện tích dự kiến -->
                                <div>
                                    <label class="block text-xs font-bold text-[#16315E] uppercase tracking-wider mb-2">Diện tích dự kiến (m²)</label>
                                    <input type="text" placeholder="VD: 5.000" class="w-full bg-[#FAF9F9] border border-[#E6EAF2] rounded-lg px-4 py-3 text-sm text-[#16315E] focus:outline-none focus:border-[#214080] transition">
                                </div>

                                <!-- Tiến độ mong muốn -->
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold text-[#16315E] uppercase tracking-wider mb-2">Tiến độ mong muốn</label>
                                    <select class="w-full bg-[#FAF9F9] border border-[#E6EAF2] rounded-lg px-4 py-3 text-sm text-[#16315E] focus:outline-none focus:border-[#214080] transition cursor-pointer">
                                        <option value="">Chọn thời gian khởi công/hoàn thành</option>
                                        <option value="ngay">Càng sớm càng tốt (Trong quý này)</option>
                                        <option value="3-thang">Trong 3 tháng tới</option>
                                        <option value="6-thang">Trong 6 tháng tới</option>
                                        <option value="nam-sau">Năm tới</option>
                                    </select>
                                </div>

                                <!-- Phạm vi công việc -->
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold text-[#16315E] uppercase tracking-wider mb-2">Phạm vi công việc cần báo giá <span class="text-red-600">*</span></label>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <label class="flex items-center gap-2 text-sm text-[#16315E] cursor-pointer">
                                            <input type="checkbox" name="scope" value="thiet-ke-thi-cong" class="rounded text-[#214080] focus:ring-[#214080]">
                                            <span>Thiết kế và thi công trọn gói</span>
                                        </label>
                                        <label class="flex items-center gap-2 text-sm text-[#16315E] cursor-pointer">
                                            <input type="checkbox" name="scope" value="thi-cong-xay-dung" class="rounded text-[#214080] focus:ring-[#214080]">
                                            <span>Thi công xây dựng</span>
                                        </label>
                                        <label class="flex items-center gap-2 text-sm text-[#16315E] cursor-pointer">
                                            <input type="checkbox" name="scope" value="ket-cau-thep" class="rounded text-[#214080] focus:ring-[#214080]">
                                            <span>Kết cấu thép / kết cấu bê tông</span>
                                        </label>
                                        <label class="flex items-center gap-2 text-sm text-[#16315E] cursor-pointer">
                                            <input type="checkbox" name="scope" value="ha-tang-phu-tro" class="rounded text-[#214080] focus:ring-[#214080]">
                                            <span>Hạ tầng và công trình phụ trợ</span>
                                        </label>
                                        <label class="flex items-center gap-2 text-sm text-[#16315E] cursor-pointer sm:col-span-2">
                                            <input type="checkbox" name="scope" value="tu-van-khac" class="rounded text-[#214080] focus:ring-[#214080]">
                                            <span>Tư vấn / hạng mục khác</span>
                                        </label>
                                    </div>
                                </div>

                                <!-- Mô tả yêu cầu -->
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold text-[#16315E] uppercase tracking-wider mb-2">Mô tả yêu cầu</label>
                                    <textarea rows="4" placeholder="Quy mô, công năng, yêu cầu kỹ thuật, ngân sách dự kiến hoặc thông tin tin khác..." class="w-full bg-[#FAF9F9] border border-[#E6EAF2] rounded-lg p-4 text-sm text-[#16315E] focus:outline-none focus:border-[#214080] transition resize-none"></textarea>
                                    <div class="text-right text-xs text-slate-400 mt-1">0/500</div>
                                </div>

                            </div>
                        </div>

                        <!-- PHẦN 2: THÔNG TIN LIÊN HỆ -->
                        <div>
                            <h4 class="text-base font-bold text-[#16315E] uppercase tracking-wide mb-4 pb-2 border-b border-[#E6EAF2] flex items-center gap-2">
                                <span class="w-6 h-6 rounded-full bg-[#214080] text-white text-xs flex items-center justify-center">2</span>
                                <span>Thông tin liên hệ</span>
                            </h4>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                
                                <!-- Họ và tên -->
                                <div>
                                    <label class="block text-xs font-bold text-[#16315E] uppercase tracking-wider mb-2">Họ và tên / Người đại diện <span class="text-red-600">*</span></label>
                                    <input type="text" required placeholder="Nhập họ và tên" class="w-full bg-[#FAF9F9] border border-[#E6EAF2] rounded-lg px-4 py-3 text-sm text-[#16315E] focus:outline-none focus:border-[#214080] transition">
                                </div>

                                <!-- Số điện thoại -->
                                <div>
                                    <label class="block text-xs font-bold text-[#16315E] uppercase tracking-wider mb-2">Số điện thoại <span class="text-red-600">*</span></label>
                                    <input type="tel" required placeholder="Nhập số điện thoại" class="w-full bg-[#FAF9F9] border border-[#E6EAF2] rounded-lg px-4 py-3 text-sm text-[#16315E] focus:outline-none focus:border-[#214080] transition">
                                </div>

                                <!-- Email -->
                                <div class="md:col-span-2">
