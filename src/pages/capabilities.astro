---
import Layout from '../layouts/layout.astro';
---

<Layout title="Năng Lực Doanh Nghiệp | VIKI Construction Corporation">

    <div class="bg-[#FAF9F9] min-h-screen pb-20">
        
        <!-- HERO BANNER -->
        <section class="bg-[#214080] text-white pt-16 pb-20 border-b-4 border-[#FFC709] relative overflow-hidden">
            <div class="container mx-auto px-4 relative z-10">
                <div class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#5FD1C1] mb-3">VIKI CAPABILITIES & INFRASTRUCTURE</div>
                <h1 class="text-[59px] font-extrabold uppercase tracking-tight leading-[1.15] mb-6">
                    <span class="block mb-2">NĂNG LỰC TOÀN DIỆN</span>
                    <span class="text-[#38B6FF] whitespace-nowrap">Vững Vàng Triển Khai Mọi Dự Án</span>
                </h1>
                <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-light max-w-3xl">
                    Sở hữu đội ngũ nhân sự chuyên môn cao, hệ thống trang thiết bị thi công hiện đại cùng bộ máy quản trị tối ưu, VIKI đáp ứng trọn vẹn các tiêu chuẩn khắt khe nhất của các dự án xây dựng công nghiệp và dân dụng quy mô lớn.
                </p>
            </div>
        </section>

        <!-- SECTION 1: CÁC NĂNG LỰC CỐT LÕI -->
        <section class="py-16 bg-white border-b border-[#E6EAF2]">
            <div class="container mx-auto px-4">
                <div class="flex items-center gap-3 mb-12 pb-4 border-b-2 border-[#16315E]">
                    <img src="/icon-hamburger-blue.png" alt="Icon" class="w-8 h-8 object-contain">
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#16315E] m-0 uppercase tracking-wide">
                        NĂNG LỰC KỸ THUẬT &amp; THI CÔNG
                    </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    
                    <div class="bg-[#FAF9F9] p-8 border border-[#E6EAF2] rounded-xl shadow-sm hover:shadow-md transition">
                        <div class="w-12 h-12 bg-[#214080] text-white rounded-lg flex items-center justify-center font-bold text-xl mb-6">01</div>
                        <h3 class="text-xl font-bold uppercase text-[#214080] mb-3">Tổng thầu Xây dựng & MEP</h3>
                        <p class="text-sm text-[#5A6E85] leading-relaxed m-0 text-justify">
                            Triển khai tổng thầu thiết kế và thi công các nhà máy công nghiệp, khu chế xuất, kho vận quy mô lớn và tổ hợp kỹ thuật cao đảm bảo tiêu chuẩn quốc tế.
                        </p>
                    </div>

                    <div class="bg-[#FAF9F9] p-8 border border-[#E6EAF2] rounded-xl shadow-sm hover:shadow-md transition">
                        <div class="w-12 h-12 bg-[#264ABC] text-white rounded-lg flex items-center justify-center font-bold text-xl mb-6">02</div>
                        <h3 class="text-xl font-bold uppercase text-[#214080] mb-3">Năng lực Kết cấu Thép</h3>
                        <p class="text-sm text-[#5A6E85] leading-relaxed m-0 text-justify">
                            Làm chủ công nghệ gia công, lắp dựng kết cấu thép nhịp lớn, hệ thống bao che và các giải pháp chống ăn mòn tiêu chuẩn công nghiệp nặng.
                        </p>
                    </div>

                    <div class="bg-[#FAF9F9] p-8 border border-[#E6EAF2] rounded-xl shadow-sm hover:shadow-md transition">
                        <div class="w-12 h-12 bg-[#38B6FF] text-white rounded-lg flex items-center justify-center font-bold text-xl mb-6">03</div>
                        <h3 class="text-xl font-bold uppercase text-[#214080] mb-3">Hạ tầng Nông nghiệp Công nghệ cao</h3>
                        <p class="text-sm text-[#5A6E85] leading-relaxed m-0 text-justify">
                            Chuyên môn sâu trong việc đầu tư, xây dựng hệ thống trang trại chăn nuôi khép kín tiêu chuẩn hiện đại, tối ưu vận hành và bảo vệ môi trường.
                        </p>
                    </div>

                </div>

            </div>
        </section>

        <!-- SECTION 4: TIÊU CHUẨN CHẤT LƯỢNG -->
        <section class="py-16 bg-[#214080] text-white">
            <div class="container mx-auto px-4 text-center max-w-4xl">
                <div class="text-xs font-bold uppercase tracking-widest text-[#5FD1C1] mb-3">QUALITY ASSURANCE</div>
                <h2 class="text-2xl sm:text-4xl font-extrabold uppercase mb-6">CAM KẾT CHẤT LƯỢNG VÀ AN TOÀN</h2>
                <p class="text-sm sm:text-base text-slate-200 leading-relaxed mb-8">
                    VIKI áp dụng hệ thống quản lý chất lượng đạt chuẩn quốc tế vào toàn bộ quy trình hoạt động. Mỗi công trình bàn giao đều là minh chứng rõ nét cho uy tín, tâm huyết và năng lực thực thi đỉnh cao của tập thể VIKI.
                </p>
                <div class="inline-flex items-center gap-4 bg-[#264ABC] px-6 py-3 rounded-lg text-sm font-bold uppercase tracking-wider border border-white/20">
                    <span>TIÊU CHUẨN ISO & QUY CHUẨN XÂY DỰNG</span>
                </div>
            </div>
        </section>

    </div>


    <style>
        .viki-org-chart .scrollbar-thin::-webkit-scrollbar {
            height: 6px;
        }
        .viki-org-chart .scrollbar-thin::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .viki-org-chart .scrollbar-thin::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .viki-org-chart .scrollbar-thin::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>

</Layout>